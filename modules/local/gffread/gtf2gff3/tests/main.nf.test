// nf-core modules test gffread/gtf2gff3
nextflow_process {

    name "Test Process GFFREAD_GTF2GFF3"
    script "../main.nf"
    process "GFFREAD_GTF2GFF3"

    tag "modules"
    tag "modules_"
    tag "gffread"
    tag "gffread/gtf2gff3"

    test("chrX gtf") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.gff3,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("chrX gtf - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
