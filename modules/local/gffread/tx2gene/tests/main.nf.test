// nf-core modules test gffread/tx2gene
nextflow_process {

    name "Test Process GFFREAD_TX2GENE"
    script "../main.nf"
    process "GFFREAD_TX2GENE"

    tag "modules"
    tag "modules_"
    tag "gffread"
    tag "gffread/tx2gene"

    test("chrX gtf") {

        when {
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.tx2gene,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("chrX gtf - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
