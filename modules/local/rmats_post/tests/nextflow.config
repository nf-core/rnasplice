params {
    paired_stats = false
}

// The pipeline `modules.config` is loaded through the test profile, so the args and
// the prefix of both processes are reset here to what each test asks for
process {
    withName: RMATS_PREP {
        ext.args = '--variable-read-length --allow-clipping'
    }
    withName: RMATS_POST {
        ext.args   = { params.paired_stats ? '--paired-stats' : '' }
        ext.prefix = { "${meta.id}" }
    }
}
