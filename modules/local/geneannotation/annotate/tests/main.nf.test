// nf-core modules test geneannotation/annotate
nextflow_process {

    name "Test Process GENEANNOTATION_ANNOTATE"
    script "../main.nf"
    process "GENEANNOTATION_ANNOTATE"

    tag "modules"
    tag "modules_local"
    tag "geneannotation"
    tag "geneannotation/annotate"

    setup {
        // The gene annotation, with one versioned ID, as GENCODE writes them
        file("${outputDir}/genes.gene_annotation.tsv").text = [
            'gene_id\tgene_name\tgene_biotype',
            'ENSG00000000001\tGENE1\tprotein_coding',
            'ENSG00000000002\tGENE2\tlncRNA',
            'ENSG00000000003.4\tGENE3\tmiRNA',
        ].join('\n') + '\n'

        // A gene with two versions in the annotation, which a table ID with a third
        // version cannot be matched to without guessing
        file("${outputDir}/ambiguous.gene_annotation.tsv").text = [
            'gene_id\tgene_name\tgene_biotype',
            'ENSG00000000004.1\tGENE4A\tprotein_coding',
            'ENSG00000000004.2\tGENE4B\tprotein_coding',
        ].join('\n') + '\n'

        // DEXSeq results: a gene, an aggregate of two genes, an aggregate with a gene
        // that is not in the annotation, a gene that is not in it, and a gene whose
        // version the annotation has but the table does not
        file("${outputDir}/GBR-YRI.dexseq.results.tsv").text = [
            'groupID\tfeatureID\tpadj',
            'ENSG00000000001\tE001\t0.01',
            'ENSG00000000001+ENSG00000000002\tE001\t0.5',
            'ENSG00000000002+ENSG00000000009\tE002\tNA',
            'ENSG00000000009\tE001\t1',
            'ENSG00000000003\tE001\t0.2',
        ].join('\n') + '\n'

        // edgeR results: a CSV, with a version on its IDs that the annotation does not have
        file("${outputDir}/contrast_GBR-YRI.usage.exon.csv").text = [
            'Geneid,Chr,Start,End,Strand,FDR',
            'ENSG00000000001.7,X,100,200,+,0.01',
            'ENSG00000000002.1,X,300,400,-,0.5',
        ].join('\n') + '\n'

        // A CSV as R's write.csv writes it: every field quoted, row names in a first
        // column with an empty name, and a field holding a comma
        file("${outputDir}/quoted.usage.exon.csv").text = [
            '"","Geneid","Chr","Exons","FDR"',
            '"1","ENSG00000000001","X","E001,E002",0.01',
            '"2","ENSG00000000002","X","E003",0.5',
        ].join('\n') + '\n'

        // A table whose ID has a version that is in neither entry of the ambiguous gene
        file("${outputDir}/ambiguous.dexseq.results.tsv").text = [
            'groupID\tfeatureID\tpadj',
            'ENSG00000000004.9\tE001\t0.01',
            'ENSG00000000004.2\tE002\t0.5',
        ].join('\n') + '\n'

        // SUPPA dPSI: the header has no name for the event IDs, which start with the gene
        // ID, or with the genes SUPPA pooled
        file("${outputDir}/local_GBR-YRI.dpsi").text = [
            'local_YRI-local_GBR_dPSI\tlocal_YRI-local_GBR_p-val',
            'ENSG00000000001;SE:X:100-200:300-400:+\t-0.4\t0.02',
            'ENSG00000000001_and_ENSG00000000002;A5:X:100-200:150-200:+\t0.1\t0.9',
        ].join('\n') + '\n'
    }

    test("dexseq - aggregates and versions") {

        when {
            process {
                """
                input[0] = [ [ id:'GBR-YRI' ], file("${outputDir}/GBR-YRI.dexseq.results.tsv", checkIfExists: true) ]
                input[1] = [ [ id:'genes' ], file("${outputDir}/genes.gene_annotation.tsv", checkIfExists: true) ]
                input[2] = 'groupID'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.annotated[0][1]).readLines() == [
                    'groupID\tgene_name\tgene_biotype\tfeatureID\tpadj',
                    'ENSG00000000001\tGENE1\tprotein_coding\tE001\t0.01',
                    'ENSG00000000001+ENSG00000000002\tGENE1+GENE2\tprotein_coding+lncRNA\tE001\t0.5',
                    'ENSG00000000002+ENSG00000000009\tGENE2+NA\tlncRNA+NA\tE002\tNA',
                    'ENSG00000000009\tNA\tNA\tE001\t1',
                    'ENSG00000000003\tGENE3\tmiRNA\tE001\t0.2',
                ] },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("edger - csv") {

        when {
            process {
                """
                input[0] = [ [ id:'edger_exon' ], file("${outputDir}/contrast_GBR-YRI.usage.exon.csv", checkIfExists: true) ]
                input[1] = [ [ id:'genes' ], file("${outputDir}/genes.gene_annotation.tsv", checkIfExists: true) ]
                input[2] = 'Geneid'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.annotated[0][1]).readLines() == [
                    'Geneid,gene_name,gene_biotype,Chr,Start,End,Strand,FDR',
                    'ENSG00000000001.7,GENE1,protein_coding,X,100,200,+,0.01',
                    'ENSG00000000002.1,GENE2,lncRNA,X,300,400,-,0.5',
                ] },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("edger - quoted csv") {

        when {
            process {
                """
                input[0] = [ [ id:'edger_exon' ], file("${outputDir}/quoted.usage.exon.csv", checkIfExists: true) ]
                input[1] = [ [ id:'genes' ], file("${outputDir}/genes.gene_annotation.tsv", checkIfExists: true) ]
                input[2] = 'Geneid'
                """
            }
        }

        then {
            // The fields are read as CSV, so the comma inside a quoted field stays in its
            // field. The copy only quotes the fields that need it
            assertAll(
                { assert process.success },
                { assert path(process.out.annotated[0][1]).readLines() == [
                    ',Geneid,gene_name,gene_biotype,Chr,Exons,FDR',
                    '1,ENSG00000000001,GENE1,protein_coding,X,"E001,E002",0.01',
                    '2,ENSG00000000002,GENE2,lncRNA,X,E003,0.5',
                ] },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("dexseq - ambiguous version") {

        when {
            process {
                """
                input[0] = [ [ id:'ambiguous' ], file("${outputDir}/ambiguous.dexseq.results.tsv", checkIfExists: true) ]
                input[1] = [ [ id:'genes' ], file("${outputDir}/ambiguous.gene_annotation.tsv", checkIfExists: true) ]
                input[2] = 'groupID'
                """
            }
        }

        then {
            // An ID whose unversioned form is shared by two genes gets NA rather than one
            // of them, while an exact match still gets its gene
            assertAll(
                { assert process.success },
                { assert path(process.out.annotated[0][1]).readLines() == [
                    'groupID\tgene_name\tgene_biotype\tfeatureID\tpadj',
                    'ENSG00000000004.9\tNA\tNA\tE001\t0.01',
                    'ENSG00000000004.2\tGENE4B\tprotein_coding\tE002\t0.5',
                ] },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("suppa - event ids") {

        when {
            process {
                """
                input[0] = [ [ id:'local_GBR-YRI' ], file("${outputDir}/local_GBR-YRI.dpsi", checkIfExists: true) ]
                input[1] = [ [ id:'genes' ], file("${outputDir}/genes.gene_annotation.tsv", checkIfExists: true) ]
                input[2] = 'event_id'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.annotated[0][1]).readLines() == [
                    'event_id\tgene_name\tgene_biotype\tlocal_YRI-local_GBR_dPSI\tlocal_YRI-local_GBR_p-val',
                    'ENSG00000000001;SE:X:100-200:300-400:+\tGENE1\tprotein_coding\t-0.4\t0.02',
                    'ENSG00000000001_and_ENSG00000000002;A5:X:100-200:150-200:+\tGENE1_and_GENE2\tprotein_coding_and_lncRNA\t0.1\t0.9',
                ] },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("missing id column") {

        when {
            process {
                """
                input[0] = [ [ id:'GBR-YRI' ], file("${outputDir}/GBR-YRI.dexseq.results.tsv", checkIfExists: true) ]
                input[1] = [ [ id:'genes' ], file("${outputDir}/genes.gene_annotation.tsv", checkIfExists: true) ]
                input[2] = 'geneID'
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.stdout.any { line -> line.contains("has no 'geneID' column") } ||
                    process.stderr.any { line -> line.contains("has no 'geneID' column") } }
            )
        }

    }

    test("dexseq - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'GBR-YRI' ], file("${outputDir}/GBR-YRI.dexseq.results.tsv", checkIfExists: true) ]
                input[1] = [ [ id:'genes' ], file("${outputDir}/genes.gene_annotation.tsv", checkIfExists: true) ]
                input[2] = 'groupID'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
