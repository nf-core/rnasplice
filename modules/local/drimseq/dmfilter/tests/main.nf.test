// nf-core modules test drimseq/dmfilter
nextflow_process {

    name "Test Process DRIMSEQ_DMFILTER"
    script "../main.nf"
    process "DRIMSEQ_DMFILTER"

    tag "modules"
    tag "modules_"
    tag "drimseq"
    tag "drimseq/dmfilter"

    test("tximport transcript counts") {

        when {
            process {
                """
                input[0] = file(params.modules_testdata_base_path + 'genomics/homo_sapiens/rnaseq_expression/chrX.transcript_counts.tsv', checkIfExists: true)
                input[1] = file(params.modules_testdata_base_path + 'genomics/homo_sapiens/rnaseq_expression/chrX.samplesheet.csv', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.drimseq_samples_tsv,
                    process.out.drimseq_counts_tsv,
                    process.out.drimseq_dataset_rds.collect { rds -> file(rds).name },
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("tximport transcript counts - no filtering") {

        config "./no_filter.config"

        when {
            process {
                """
                input[0] = file(params.modules_testdata_base_path + 'genomics/homo_sapiens/rnaseq_expression/chrX.transcript_counts.tsv', checkIfExists: true)
                input[1] = file(params.modules_testdata_base_path + 'genomics/homo_sapiens/rnaseq_expression/chrX.samplesheet.csv', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.drimseq_samples_tsv,
                    process.out.drimseq_counts_tsv,
                    process.out.drimseq_dataset_rds.collect { rds -> file(rds).name },
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("tximport transcript counts - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = file(params.modules_testdata_base_path + 'genomics/homo_sapiens/rnaseq_expression/chrX.transcript_counts.tsv', checkIfExists: true)
                input[1] = file(params.modules_testdata_base_path + 'genomics/homo_sapiens/rnaseq_expression/chrX.samplesheet.csv', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
