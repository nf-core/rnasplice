// nf-core modules test suppatpm
nextflow_process {

    name "Test Process SUPPATPM"
    script "../main.nf"
    process "SUPPATPM"

    tag "modules"
    tag "modules_local"
    tag "suppatpm"

    test("homo_sapiens - chrX - tximport transcript table") {

        when {
            process {
                """
                input[0] = [
                    [ id:'suppa_tpm' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/rnaseq_expression/chrX.transcript_counts.tsv', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def lines = path(process.out.tpm[0][1]).readLines()
            assertAll(
                { assert process.success },
                { assert lines[0].split('\t') as List == ['ERR188383', 'ERR188428', 'ERR188454', 'ERR204916'] },
                { assert lines.drop(1).every { line -> line.split('\t').size() == 5 } },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("homo_sapiens - chrX - tximport transcript table - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'suppa_tpm' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/rnaseq_expression/chrX.transcript_counts.tsv', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }
    }
}
