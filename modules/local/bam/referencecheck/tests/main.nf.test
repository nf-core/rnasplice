// nf-core modules test bam/referencecheck
nextflow_process {

    name "Test Process BAM_REFERENCECHECK"
    script "../main.nf"
    process "BAM_REFERENCECHECK"

    tag "modules"
    tag "modules_"
    tag "bam"
    tag "bam/referencecheck"

    test("chrX genome bam - matching reference") {

        when {
            process {
                """
                input[0] = [
                    [ id:'ERR188383' ],
                    file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam', checkIfExists: true)
                ]
                input[1] = [ [ id:'X' ], file("${moduleTestDir}/data/X.fa.fai", checkIfExists: true) ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.bam.collect { meta, bam -> [ meta, file(bam).name ] },
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("chrX genome bam - other reference") {

        when {
            process {
                """
                input[0] = [
                    [ id:'ERR188383' ],
                    file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam', checkIfExists: true)
                ]
                input[1] = [ [ id:'chrX' ], file("${moduleTestDir}/data/chrX.fa.fai", checkIfExists: true) ]
                """
            }
        }

        then {
            assert process.failed
            assert process.stdout.any { line -> line.contains('was not aligned to chrX.fa') }
        }

    }

    test("chrX genome bam - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'ERR188383' ],
                    file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam', checkIfExists: true)
                ]
                input[1] = [ [ id:'X' ], file("${moduleTestDir}/data/X.fa.fai", checkIfExists: true) ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.bam.collect { meta, bam -> [ meta, file(bam).name ] },
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

}
