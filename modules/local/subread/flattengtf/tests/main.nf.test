// nf-core modules test subread/flattengtf
nextflow_process {

    name "Test Process SUBREAD_FLATTENGTF"
    script "../main.nf"
    process "SUBREAD_FLATTENGTF"

    tag "modules"
    tag "modules_local"
    tag "subread"
    tag "subread/flattengtf"

    test("human chrX - gtf") {

        when {
            process {
                """
                input[0] = [
                    [ id:'human_chrX' ],
                    file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    sanitizeOutput(process.out),
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("human chrX - gtf - stub") {

        options "-stub"

        when {
            process {
                """
                // TODO nf-core: define inputs of the process here. Example:

                input[0] = [
                    [ id:'human_chrX' ],
                    file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
