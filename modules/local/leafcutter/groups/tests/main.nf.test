nextflow_process {

    name "Test Process LEAFCUTTER_GROUPS"
    script "../main.nf"
    process "LEAFCUTTER_GROUPS"

    tag "modules"
    tag "modules_local"
    tag "leafcutter"
    tag "leafcutter/groups"

    test("two conditions") {

        when {
            process {
                """
                input[0] = [
                    [ id:'GBR-YRI' ],
                    [ [ 'ERR188383', 'GBR' ], [ 'ERR188428', 'GBR' ], [ 'ERR188454', 'YRI' ], [ 'ERR204916', 'YRI' ] ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("blocking variables") {

        when {
            process {
                """
                input[0] = [
                    [ id:'GBR-YRI' ],
                    [ [ 'ERR188383', 'GBR', 'batch_1' ], [ 'ERR188428', 'GBR', 'batch_2' ], [ 'ERR188454', 'YRI', 'batch_1' ], [ 'ERR204916', 'YRI', 'batch_2' ] ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
