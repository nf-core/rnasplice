// nf-core modules test leafcutter/gtftoexons
nextflow_process {

    name "Test Process LEAFCUTTER_GTFTOEXONS"
    script "../main.nf"
    process "LEAFCUTTER_GTFTOEXONS"

    tag "modules"
    tag "modules_local"
    tag "leafcutter"
    tag "leafcutter/gtftoexons"

    test("human chrX - gtf") {

        when {
            process {
                """
                input[0] = [
                    [ id:'genes_chrX' ],
                    file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def lines = path(process.out.exons[0][1]).linesGzip
            assertAll(
                { assert process.success },
                { assert lines[0] == "chr\tstart\tend\tstrand\tgene_name" },
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("human chrX - gtf - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'genes_chrX' ],
                    file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
