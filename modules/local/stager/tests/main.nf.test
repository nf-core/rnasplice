// nf-core modules test stager
nextflow_process {

    name "Test Process STAGER"
    script "../main.nf"
    process "STAGER"

    tag "modules"
    tag "modules_"
    tag "stager"

    test("dexseq results - tsv") {

        when {
            process {
                """
                input[0] = [
                    [ id:'treatment-control' ],
                    file("${moduleTestDir}/DEXSeqResults.treatment-control.tsv", checkIfExists: true),
                    file("${moduleTestDir}/perGeneQValue.treatment-control.tsv", checkIfExists: true)
                ]
                input[1] = 'dexseq'
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.stager_padj_tsv,
                    process.out.stager_rds.collect { meta, rds -> [ meta, file(rds).name ] },
                    process.out.stager_padj_rds.collect { meta, rds -> [ meta, file(rds).name ] },
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("dexseq results - tsv - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'treatment-control' ],
                    file("${moduleTestDir}/DEXSeqResults.treatment-control.tsv", checkIfExists: true),
                    file("${moduleTestDir}/perGeneQValue.treatment-control.tsv", checkIfExists: true)
                ]
                input[1] = 'dexseq'
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
