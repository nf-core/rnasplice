// nf-core modules test aspli/du
nextflow_process {

    name "Test Process ASPLI_DU"
    script "../main.nf"
    process "ASPLI_DU"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "aspli"
    tag "aspli/du"
    tag "aspli/counts"

    // ASPLI_DU tests the counts of ASPLI_COUNTS, so the reads of the four test samples
    // are counted first
    setup {

        run("ASPLI_COUNTS") {
            script "../../counts/main.nf"
            process {
            """
            def samples = [ ERR188383:'GBR', ERR188428:'GBR', ERR188454:'YRI', ERR204916:'YRI' ]
            def targets = channel
                .of(
                    ( [ 'sample\\tcondition\\tbam\\tsingle_end\\tstrandedness' ] +
                      samples.collect { id, condition -> "\${id}\\t\${condition}\\t\${id}.Aligned.out.bam\\tfalse\\tunstranded" } ).join('\\n') + '\\n'
                )
                .collectFile(name: 'targets.tsv')
            input[0] = targets.map { tsv ->
                [
                    [ id:'aspli' ],
                    tsv,
                    samples.keySet().collect { id -> file(params.pipelines_testdata_base_path + "testdata/\${id}.Aligned.out.bam", checkIfExists: true) },
                    samples.keySet().collect { id -> file(params.pipelines_testdata_base_path + "testdata/\${id}.Aligned.out.bam.bai", checkIfExists: true) },
                ]
            }
            input[1] = [
                [ id:'genes_chrX' ],
                file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true),
            ]
            input[2] = 0
            """
            }
        }

    }

    test("human chrX - contrast") {

        when {
            process {
                """
                input[0] = ASPLI_COUNTS.out.features
                    .join(ASPLI_COUNTS.out.gbcounts)
                    .join(ASPLI_COUNTS.out.jcounts)
                    .map { _meta, features, gbcounts, jcounts -> [ [ id:'GBR-YRI', treatment:'GBR', control:'YRI' ], features, gbcounts, jcounts ] }
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert path(process.out.gb_du[0][1].find { tsv -> tsv.endsWith('.genes_de.tsv') }).readLines()[0].startsWith('gene\tsymbol') },
                { assert path(process.out.integrated_signals_html[0][1]).resolve('integratedSignals.html').exists() },
                { assert snapshot(
                    // The tables hold statistics that differ in the last digits between
                    // builds, so they are checked by name only, as are the R objects
                    process.out.gb_du.collect { meta, tsvs -> [ meta, tsvs.collect { tsv -> file(tsv).name } ] },
                    process.out.j_du.collect { meta, tsvs -> [ meta, tsvs.collect { tsv -> file(tsv).name } ] },
                    process.out.splicing_report.collect { meta, tsvs -> [ meta, tsvs.collect { tsv -> file(tsv).name } ] },
                    process.out.integrated_signals.collect { meta, tsv -> [ meta, file(tsv).name ] },
                    process.out.integrated_signals_html.collect { meta, dir -> [ meta, file(dir).name ] },
                    process.out.rds.collect { meta, rds -> [ meta, file(rds).name ] },
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("human chrX - contrast - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = ASPLI_COUNTS.out.features
                    .join(ASPLI_COUNTS.out.gbcounts)
                    .join(ASPLI_COUNTS.out.jcounts)
                    .map { _meta, features, gbcounts, jcounts -> [ [ id:'GBR-YRI', treatment:'GBR', control:'YRI' ], features, gbcounts, jcounts ] }
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
