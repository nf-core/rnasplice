process {
    withName: MISOPY_RUN {
        memory = 6.GB
    }

    // The settings file lists the BAM files and the MISO output directories by name,
    // relative to the work directory MISOPY_SASHIMIPLOT stages them in
    withName: MISOPY_SETTINGS {
        ext.args = '--bam_prefix . --miso_prefix .'
    }
}
