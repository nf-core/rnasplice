// nf-core modules test isoformswitchanalyzer
nextflow_process {

    name "Test Process ISOFORMSWITCHANALYZER"
    script "../main.nf"
    process "ISOFORMSWITCHANALYZER"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "isoformswitchanalyzer"
    tag "untar"
    tag "gunzip"
    tag "gffread"

    // The salmon_quant tarball holds one quant directory per sample (ERR188383,
    // ERR188428, ERR188454, ERR204916), quantified against reference/genes_chrX.gtf.
    // The test-datasets carry no transcript fasta, so it is extracted from the
    // chrX genome with gffread -w, as the pipeline does with rsem-prepare-reference
    setup {
        run("UNTAR", alias: "UNTAR_SALMON_QUANT") {
            script '../../../nf-core/untar/main.nf'
            process {
            """
            input[0] = [
                [ id: 'test' ],
                file(params.pipelines_testdata_base_path + 'testdata/salmon_quant/salmon_quant.tar.gz', checkIfExists: true)
            ]
            """
            }
        }

        run("GUNZIP") {
            script '../../../nf-core/gunzip/main.nf'
            process {
            """
            input[0] = [
                [ id: 'X' ],
                file(params.pipelines_testdata_base_path + 'reference/X.fa.gz', checkIfExists: true)
            ]
            """
            }
        }

        run("GFFREAD") {
            script '../../../nf-core/gffread/main.nf'
            process {
            """
            input[0] = [
                [ id: 'genes_chrX' ],
                file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true)
            ]
            input[1] = GUNZIP.out.gunzip.map { _meta, fasta -> fasta }
            """
            }
        }
    }

    test("human chrX - salmon quant") {

        // The switch summary only holds counts, so it is snapshotted by content.
        // The isoform features table carries the DEXSeq statistics, which are not
        // reproducible across machines, so it is snapshotted by shape: header and
        // row count. The plots are listed by name, one per switching gene, and the
        // binary object only by name. Treatment minus control puts the control, YRI,
        // first in the table
        when {
            def design = File.createTempFile('design', '.csv')
            design.text = 'sample,condition\nERR188383,GBR\nERR188428,GBR\nERR188454,YRI\nERR204916,YRI\n'
            def contrastsheet = File.createTempFile('contrastsheet', '.csv')
            contrastsheet.text = 'contrast,treatment,control\nGBR-YRI,GBR,YRI\n'
            process {
                """
                input[0] = UNTAR_SALMON_QUANT.out.untar
                    .map { _meta, dir -> [ [ id: 'GBR-YRI' ], files(dir.toString() + '/ERR*', type: 'dir', checkIfExists: true), file('${design.absolutePath}', checkIfExists: true), file('${contrastsheet.absolutePath}', checkIfExists: true) ] }
                input[1] = file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true)
                input[2] = GFFREAD.out.gffread_fasta.map { _meta, fasta -> fasta }
                input[3] = 0.05
                input[4] = 0.1
                """
            }
        }

        then {
            assert process.success
            def lines = path(process.out.isoformswitchanalyzer_isoformFeatures[0][1]).readLines()
            def header = lines[0].split(',').collect { it.replace('"', '') }
            def pairs = lines.drop(1).collect { line ->
                def fields = line.split(',').collect { it.replace('"', '') }
                [ fields[header.indexOf('condition_1')], fields[header.indexOf('condition_2')] ]
            }.unique()
            assertAll(
                { assert pairs == [ [ 'YRI', 'GBR' ] ] },
                { assert snapshot(
                    process.out.isoformswitchanalyzer_summary,
                    process.out.isoformswitchanalyzer_isoformFeatures.collect { meta, csv ->
                        def lines = path(csv).readLines()
                        [ meta, file(csv).name, lines[0], lines.size() ]
                    },
                    process.out.switchlist_rds.collect { meta, rds -> [ meta, file(rds).name ] },
                    process.out.results.collect { _meta, dir ->
                        getAllFilesFromDir(dir, relative: true)
                    },
                    process.out.findAll { key, _val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("human chrX - salmon quant - blocking variable as covariate") {

        // A batch column crossed with condition goes into the switch test as a covariate
        when {
            def design = File.createTempFile('design', '.csv')
            design.text = 'sample,condition,batch\nERR188383,GBR,batch_1\nERR188428,GBR,batch_2\nERR188454,YRI,batch_1\nERR204916,YRI,batch_2\n'
            def contrastsheet = File.createTempFile('contrastsheet', '.csv')
            contrastsheet.text = 'contrast,treatment,control\nGBR-YRI,GBR,YRI\n'
            process {
                """
                input[0] = UNTAR_SALMON_QUANT.out.untar
                    .map { _meta, dir -> [ [ id: 'GBR-YRI' ], files(dir.toString() + '/ERR*', type: 'dir', checkIfExists: true), file('${design.absolutePath}', checkIfExists: true), file('${contrastsheet.absolutePath}', checkIfExists: true) ] }
                input[1] = file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true)
                input[2] = GFFREAD.out.gffread_fasta.map { _meta, fasta -> fasta }
                input[3] = 0.05
                input[4] = 0.1
                """
            }
        }

        then {
            assert process.success
            def lines = path(process.out.isoformswitchanalyzer_isoformFeatures[0][1]).readLines()
            assertAll(
                { assert lines.size() > 1 },
                { assert snapshot(
                    process.out.isoformswitchanalyzer_isoformFeatures.collect { meta, csv ->
                        def lines = path(csv).readLines()
                        [ meta, file(csv).name, lines[0], lines.size() ]
                    },
                ).match() }
            )
        }

    }

    test("human chrX - salmon quant - no switches") {

        // A dIF cutoff no isoform reaches: the analysis stops after the switch test,
        // the summary holds the error message and the features table is empty
        when {
            def design = File.createTempFile('design', '.csv')
            design.text = 'sample,condition\nERR188383,GBR\nERR188428,GBR\nERR188454,YRI\nERR204916,YRI\n'
            def contrastsheet = File.createTempFile('contrastsheet', '.csv')
            contrastsheet.text = 'contrast,treatment,control\nGBR-YRI,GBR,YRI\n'
            process {
                """
                input[0] = UNTAR_SALMON_QUANT.out.untar
                    .map { _meta, dir -> [ [ id: 'GBR-YRI' ], files(dir.toString() + '/ERR*', type: 'dir', checkIfExists: true), file('${design.absolutePath}', checkIfExists: true), file('${contrastsheet.absolutePath}', checkIfExists: true) ] }
                input[1] = file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true)
                input[2] = GFFREAD.out.gffread_fasta.map { _meta, fasta -> fasta }
                input[3] = 0.05
                input[4] = 0.99
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.isoformswitchanalyzer_summary,
                    process.out.isoformswitchanalyzer_isoformFeatures,
                    process.out.switchlist_rds.collect { meta, rds -> [ meta, file(rds).name ] },
                    process.out.results.collect { _meta, dir ->
                        getAllFilesFromDir(dir, relative: true)
                    },
                    process.out.findAll { key, _val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("human chrX - salmon quant - stub") {

        options "-stub"

        when {
            def design = File.createTempFile('design', '.csv')
            design.text = 'sample,condition\nERR188383,GBR\nERR188428,GBR\nERR188454,YRI\nERR204916,YRI\n'
            def contrastsheet = File.createTempFile('contrastsheet', '.csv')
            contrastsheet.text = 'contrast,treatment,control\nGBR-YRI,GBR,YRI\n'
            process {
                """
                input[0] = UNTAR_SALMON_QUANT.out.untar
                    .map { _meta, dir -> [ [ id: 'GBR-YRI' ], files(dir.toString() + '/ERR*', type: 'dir', checkIfExists: true), file('${design.absolutePath}', checkIfExists: true), file('${contrastsheet.absolutePath}', checkIfExists: true) ] }
                input[1] = file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true)
                input[2] = GFFREAD.out.gffread_fasta.map { _meta, fasta -> fasta }
                input[3] = 0.05
                input[4] = 0.1
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
