// nf-core modules test tximeta/tximport
nextflow_process {

    name "Test Process TXIMETA_TXIMPORT"
    script "../main.nf"
    process "TXIMETA_TXIMPORT"
    config "./nextflow.config"

    tag "modules"
    tag "modules_"
    tag "tximeta"
    tag "tximeta/tximport"
    tag "untar"

    // The salmon_quant tarball holds one quant directory per sample
    // (ERR188383, ERR188428, ERR188454, ERR204916) plus the matching
    // genes_chrX.tx2gene.tsv, so it provides both process inputs.
    setup {
        run("UNTAR", alias: "UNTAR_SALMON_QUANT") {
            script '../../../../nf-core/untar/main.nf'
            process {
            """
            input[0] = [
                [ id: 'test' ],
                file(params.pipelines_testdata_base_path + 'testdata/salmon_quant/salmon_quant.tar.gz', checkIfExists: true)
            ]
            """
            }
        }
    }

    test("human chrX - salmon quant") {

        when {
            process {
            """
            UNTAR_SALMON_QUANT.out.untar
                .multiMap { meta, dir ->
                    quants : [ meta, file(dir.toString() + '/ERR*', type: 'dir', checkIfExists: true) ]
                    tx2gene: file(dir.toString() + '/genes_chrX.tx2gene.tsv', checkIfExists: true)
                }
                .set { ch_salmon_quant }

            input[0] = ch_salmon_quant.quants
            input[1] = ch_salmon_quant.tx2gene
            """
            }
        }

        then {
            assert process.success

            assertAll(
                { assert snapshot(
                    sanitizeOutput(
                        process.out,
                        unstableKeys: ["txi", "txi_s", "txi_ls", "txi_dtu", "gi", "gi_s", "gi_ls"]
                    ),
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("human chrX - salmon quant - ignore_tx_version") {

        config "./ignore_tx_version.config"

        when {
            process {
            """
            UNTAR_SALMON_QUANT.out.untar
                .multiMap { meta, dir ->
                    quants : [ meta, file(dir.toString() + '/ERR*', type: 'dir', checkIfExists: true) ]
                    tx2gene: file(dir.toString() + '/genes_chrX.tx2gene.tsv', checkIfExists: true)
                }
                .set { ch_salmon_quant }

            input[0] = ch_salmon_quant.quants
            input[1] = ch_salmon_quant.tx2gene
            """
            }
        }

        then {
            assert process.success

            assertAll(
                { assert snapshot(
                    sanitizeOutput(
                        process.out,
                        unstableKeys: ["txi", "txi_s", "txi_ls", "txi_dtu", "gi", "gi_s", "gi_ls"]
                    ),
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    // The test data carries no transcript versions, so the case `--ignore_tx_version`
    // exists for is built inline: versioned IDs in both the quantifications and tx2gene
    test("versioned transcript IDs - ignore_tx_version") {

        config "./ignore_tx_version.config"

        when {
            process {
            """
            def fixture = new File("\${launchDir}/versioned_fixture")
            fixture.mkdirs()
            def samples = []
            ['S1', 'S2'].each { s ->
                def dir = new File(fixture, s)
                dir.mkdirs()
                new File(dir, 'quant.sf').text = "Name\\tLength\\tEffectiveLength\\tTPM\\tNumReads\\nENST01.3\\t1000\\t900\\t500\\t50\\nENST02.1\\t2000\\t1900\\t500\\t100\\n"
                samples << file(dir.toString(), type: 'dir')
            }
            def tx2gene = new File(fixture, 'tx2gene.tsv')
            tx2gene.text = "ENST01.3\\tG1\\tg1\\nENST02.1\\tG1\\tg1\\n"

            input[0] = [ [ id:'test' ], samples ]
            input[1] = file(tx2gene.toString())
            """
            }
        }

        then {
            // The transcript tables must lose the versions, as tx2gene does
            assertAll(
                { assert process.success },
                { assert path(process.out.counts_transcript[0]).readLines().drop(1).collect { line -> line.split('\t')[0] } == ['ENST01', 'ENST02'] },
                { assert path(process.out.counts_transcript_dtu_scaled[0]).readLines().drop(1).collect { line -> line.split('\t')[0] } == ['ENST01', 'ENST02'] }
            )
        }

    }

    test("human chrX - salmon quant - stub") {

        options "-stub"

        when {
            process {
            """
            UNTAR_SALMON_QUANT.out.untar
                .multiMap { meta, dir ->
                    quants : [ meta, file(dir.toString() + '/ERR*', type: 'dir', checkIfExists: true) ]
                    tx2gene: file(dir.toString() + '/genes_chrX.tx2gene.tsv', checkIfExists: true)
                }
                .set { ch_salmon_quant }

            input[0] = ch_salmon_quant.quants
            input[1] = ch_salmon_quant.tx2gene
            """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

}
