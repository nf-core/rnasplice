{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/rnasplice/master/assets/schema_input_transcriptome_bam.json",
    "title": "nf-core/rnasplice pipeline - params.input schema (transcriptome_bam source)",
    "description": "Schema for the file provided with params.input when --source transcriptome_bam",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^(?!\\.\\.\\d+)(?!\\.$)[a-zA-Z.]([a-zA-Z0-9._]*)?$",
                "not": {
                    "enum": [
                        "if",
                        "else",
                        "repeat",
                        "while",
                        "function",
                        "for",
                        "in",
                        "next",
                        "break",
                        "TRUE",
                        "FALSE",
                        "NULL",
                        "Inf",
                        "NaN",
                        "NA",
                        "NA_integer_",
                        "NA_real_",
                        "NA_complex_",
                        "NA_character_",
                        "...",
                        "..1",
                        "..2",
                        "..3",
                        "..4",
                        "..5",
                        "..6",
                        "..7",
                        "..8",
                        "..9"
                    ]
                },
                "errorMessage": {
                    "pattern": "Sample name must be a valid R identifier: start with a letter or '.', contain only letters, digits, '.', or '_', and not start with '.' followed by a digit",
                    "not": "Sample name must not be an R reserved keyword"
                },
                "meta": ["id"]
            },
            "condition": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Condition must be provided and contain syntactically valid names.",
                "meta": ["condition"]
            },
            "strandedness": {
                "type": "string",
                "errorMessage": "Strandedness must be one of 'forward', 'reverse' or 'unstranded'",
                "enum": ["forward", "reverse", "unstranded"],
                "default": "unstranded",
                "meta": ["strandedness"]
            },
            "single_end": {
                "type": "boolean",
                "errorMessage": "Single end must be 'true' for single end reads or 'false' for paired end reads",
                "default": false,
                "meta": ["single_end"]
            },
            "genome_bam": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.bam$",
                "errorMessage": "Genome BAM file must be provided, cannot contain spaces and must have extension '.bam'"
            },
            "transcriptome_bam": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.bam$",
                "errorMessage": "Transcriptome BAM file must be provided, cannot contain spaces and must have extension '.bam'"
            }
        },
        "required": ["sample", "condition", "genome_bam", "transcriptome_bam"]
    }
}
