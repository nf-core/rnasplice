{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/rnasplice/master/assets/schema_contrasts.json",
    "title": "nf-core/rnasplice pipeline - params.contrasts schema",
    "description": "Schema for the file provided with params.contrasts. Either the id, variable, reference, target[, blocking] columns or the deprecated contrast, treatment, control columns, never both",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "contrast": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Contrast name cannot contain spaces",
                "meta": ["contrast"]
            },
            "id": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Contrast name cannot contain spaces",
                "meta": ["id"]
            },
            "treatment": {
                "type": "string",
                "pattern": "^(([A-Za-z]|[.][._A-Za-z])[._A-Za-z0-9]*)|[.]$",
                "errorMessage": "Treatment must contain a syntactically valid name (letters, numbers, dots, underscores; must start with a letter or dot not followed by a number)",
                "meta": ["treatment"]
            },
            "control": {
                "type": "string",
                "pattern": "^(([A-Za-z]|[.][._A-Za-z])[._A-Za-z0-9]*)|[.]$",
                "errorMessage": "Control must contain a syntactically valid name (letters, numbers, dots, underscores; must start with a letter or dot not followed by a number)",
                "meta": ["control"]
            },
            "target": {
                "type": "string",
                "pattern": "^(([A-Za-z]|[.][._A-Za-z])[._A-Za-z0-9]*)|[.]$",
                "errorMessage": "Target must contain a syntactically valid name (letters, numbers, dots, underscores; must start with a letter or dot not followed by a number)",
                "meta": ["target"]
            },
            "reference": {
                "type": "string",
                "pattern": "^(([A-Za-z]|[.][._A-Za-z])[._A-Za-z0-9]*)|[.]$",
                "errorMessage": "Reference must contain a syntactically valid name (letters, numbers, dots, underscores; must start with a letter or dot not followed by a number)",
                "meta": ["reference"]
            },
            "variable": {
                "type": "string",
                "enum": ["condition"],
                "errorMessage": "Variable must be 'condition', the only supported column",
                "meta": ["variable"]
            },
            "blocking": {
                "type": "string",
                "errorMessage": "Blocking must be a string",
                "meta": ["blocking"]
            }
        },
        "oneOf": [
            {
                "required": ["contrast", "treatment", "control"],
                "not": {
                    "anyOf": [
                        {
                            "required": ["id"]
                        },
                        {
                            "required": ["variable"]
                        },
                        {
                            "required": ["reference"]
                        },
                        {
                            "required": ["target"]
                        },
                        {
                            "required": ["blocking"]
                        }
                    ]
                }
            },
            {
                "required": ["id", "variable", "reference", "target"],
                "not": {
                    "anyOf": [
                        {
                            "required": ["contrast"]
                        },
                        {
                            "required": ["treatment"]
                        },
                        {
                            "required": ["control"]
                        }
                    ]
                }
            }
        ],
        "errorMessage": "Each contrast needs either all of id, variable, reference and target (blocking is optional), or all of the deprecated contrast, treatment and control, and the two sets of columns cannot be mixed"
    }
}
