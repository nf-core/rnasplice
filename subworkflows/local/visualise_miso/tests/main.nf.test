// nf-core subworkflows test visualise_miso
nextflow_workflow {

    name "Test Subworkflow VISUALISE_MISO"
    script "../main.nf"
    workflow "VISUALISE_MISO"
    config "./nextflow.config"

    tag "subworkflows"
    tag "subworkflows_"
    tag "subworkflows/visualise_miso"
    tag "gffread"
    tag "misopy"
    tag "misopy/index"
    tag "misopy/run"
    tag "misopy/sashimiplot"
    tag "misopysettings"

    test("human chrX") {

        when {
            workflow {
                """
                input[0] = channel.value(file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true))
                input[1] = channel.of([
                    [ id:'ERR188383' ],
                    file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam', checkIfExists: true),
                ])
                input[2] = channel.of([
                    [ id:'ERR188383' ],
                    file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam.bai', checkIfExists: true),
                ])
                input[3] = 7
                input[4] = 7
                input[5] = 'ENSG00000147403'
                input[6] = false
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert snapshot(
                    workflow.out.gff3,
                    workflow.out.miso_settings,
                    workflow.out.miso_sashimi.collect { meta, plots -> [ meta, file(plots).name ] }
                ).match() }
            )
        }

    }

    test("human chrX - versioned and missing genes") {

        when {
            workflow {
                """
                input[0] = channel.value(file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true))
                input[1] = channel.of([
                    [ id:'ERR188383' ],
                    file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam', checkIfExists: true),
                ])
                input[2] = channel.of([
                    [ id:'ERR188383' ],
                    file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam.bai', checkIfExists: true),
                ])
                input[3] = 7
                input[4] = 7
                input[5] = 'ENSG00000147403.17, ENSMUSG00000000001'
                input[6] = false
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert file("${outputDir}/../meta/nextflow.log").text.contains("Plotting 'ENSG00000147403' for 'ENSG00000147403.17'") },
                { assert file("${outputDir}/../meta/nextflow.log").text.contains("No sashimi plot for 'ENSMUSG00000000001'") },
                { assert snapshot(
                    workflow.out.miso_sashimi.collect { meta, plots -> [ meta, file(plots).name ] }
                ).match() }
            )
        }

    }

    test("human chrX - genes file with a missing gene") {

        when {
            def genes_file = new File("${outputDir}/miso_genes.txt")
            genes_file.parentFile.mkdirs()
            genes_file.text = "ENSG00000147403\nENSMUSG00000000001\n"
            workflow {
                """
                input[0] = channel.value(file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true))
                input[1] = channel.of([
                    [ id:'ERR188383' ],
                    file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam', checkIfExists: true),
                ])
                input[2] = channel.of([
                    [ id:'ERR188383' ],
                    file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam.bai', checkIfExists: true),
                ])
                input[3] = 7
                input[4] = 7
                input[5] = ''
                input[6] = '${genes_file}'
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert file("${outputDir}/../meta/nextflow.log").text.contains("No sashimi plot for 'ENSMUSG00000000001'") },
                { assert snapshot(
                    workflow.out.miso_sashimi.collect { meta, plots -> [ meta, file(plots).name ] }
                ).match() }
            )
        }

    }

    test("human chrX - unversioned gene, versioned GTF") {

        when {
            workflow {
                """
                input[0] = channel.fromPath(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true)
                    .splitText()
                    .filter { line -> line.contains('gene_id "ENSG00000147403"') }
                    .map { line -> line.replace('gene_id "ENSG00000147403"', 'gene_id "ENSG00000147403.17"') }
                    .collectFile(name: 'genes_chrX_versioned.gtf')
                input[1] = channel.of([
                    [ id:'ERR188383' ],
                    file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam', checkIfExists: true),
                ])
                input[2] = channel.of([
                    [ id:'ERR188383' ],
                    file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam.bai', checkIfExists: true),
                ])
                input[3] = 7
                input[4] = 7
                input[5] = 'ENSG00000147403'
                input[6] = false
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert !file("${outputDir}/../meta/nextflow.log").text.contains('Plotting') },
                { assert snapshot(
                    workflow.out.miso_sashimi.collect { meta, plots -> [ meta, file(plots).name ] }
                ).match() }
            )
        }

    }

    test("human chrX - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.value(file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true))
                input[1] = channel.of([
                    [ id:'ERR188383' ],
                    file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam', checkIfExists: true),
                ])
                input[2] = channel.of([
                    [ id:'ERR188383' ],
                    file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam.bai', checkIfExists: true),
                ])
                input[3] = 7
                input[4] = 7
                input[5] = 'ENSG00000147403'
                input[6] = false
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert snapshot(sanitizeOutput(workflow.out)).match() }
            )
        }

    }

}
