// nf-core subworkflows test aspli
nextflow_workflow {

    name "Test Subworkflow ASPLI"
    script "../main.nf"
    workflow "ASPLI"
    config "./nextflow.config"

    tag "subworkflows"
    tag "subworkflows/aspli"
    tag "aspli"
    tag "aspli/counts"
    tag "aspli/du"

    // Two GBR and two YRI samples of the pipeline test data

    test("homo_sapiens - two contrasts") {

        when {
            workflow {
                """
                def samples = [ ERR188383:'GBR', ERR188428:'GBR', ERR188454:'YRI', ERR204916:'YRI' ]
                input[0] = channel.fromList(
                    samples.collect { id, condition -> [ [ id:id, condition:condition, single_end:false, strandedness:'unstranded' ], file(params.pipelines_testdata_base_path + "testdata/\${id}.Aligned.out.bam", checkIfExists: true) ] }
                )
                input[1] = channel.fromList(
                    samples.collect { id, condition -> [ [ id:id, condition:condition, single_end:false, strandedness:'unstranded' ], file(params.pipelines_testdata_base_path + "testdata/\${id}.Aligned.out.bam.bai", checkIfExists: true) ] }
                )
                input[2] = [ [ id:'genes_chrX' ], file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true) ]
                input[3] = channel.of(
                    [ contrast:'GBR-YRI', treatment:'GBR', control:'YRI' ],
                    [ contrast:'YRI-GBR', treatment:'YRI', control:'GBR' ],
                )
                input[4] = 0
                """
            }
        }

        then {
            // The two contrasts are the same comparison the other way round, so every
            // junction has the same log fold change with the opposite sign in each
            def logfc = { contrast ->
                def tsv = workflow.out.j_du.find { meta, _tsvs -> meta.id == contrast }[1].find { tsv -> tsv.endsWith('.locale_junctions.tsv') }
                def lines = path(tsv).readLines()
                def column = lines[0].split('\t').toList().indexOf('logFC')
                lines.drop(1).collectEntries { line -> def fields = line.split('\t'); [ fields[0], fields[column] as BigDecimal ] }
            }
            def gbr_yri = logfc('GBR-YRI')
            def yri_gbr = logfc('YRI-GBR')

            // The gene log fold changes of GBR-YRI must have the sign of GBR over YRI in
            // the gene counts, which a swapped treatment and control would reverse. Genes
            // whose counts per million barely differ are left out, as normalisation can
            // flip their sign
            def samples = [ ERR188383:'GBR', ERR188428:'GBR', ERR188454:'YRI', ERR204916:'YRI' ]
            def gene_counts = path(workflow.out.counts[0][1].find { tsv -> tsv.endsWith('.gene_counts.tsv') }).readLines()*.split('\t')
            def library_sizes = samples.keySet().collectEntries { id ->
                def column = gene_counts[0].toList().indexOf(id)
                [ id, gene_counts.drop(1).sum { row -> row[column] as double } ]
            }
            def mean_cpm = { row, condition ->
                def ids = samples.findAll { _id, c -> c == condition }.keySet()
                ids.sum { id -> (row[gene_counts[0].toList().indexOf(id)] as double) / library_sizes[id] * 1e6 } / ids.size()
            }
            def genes_de = path(workflow.out.gb_du.find { meta, _tsvs -> meta.id == 'GBR-YRI' }[1].find { tsv -> tsv.endsWith('.genes_de.tsv') }).readLines()*.split('\t')
            def gene_logfc = genes_de.drop(1).collectEntries { row -> [ row[0], row[genes_de[0].toList().indexOf('logFC')] as double ] }
            // The genes tested by ASpli have reads in both conditions
            def count_ratio = gene_counts.drop(1).findAll { row -> gene_logfc.containsKey(row[0]) }.collectEntries { row ->
                [ row[0], Math.log(mean_cpm(row, 'GBR') / mean_cpm(row, 'YRI')) / Math.log(2) ]
            }
            def clear_genes = gene_logfc.keySet().findAll { gene -> count_ratio[gene].abs() > 0.05 }

            assertAll(
                { assert workflow.success },
                // The genome is binned and the reads counted once for both contrasts
                { assert workflow.out.gbcounts.size() == 1 },
                { assert workflow.out.integrated_signals.size() == 2 },
                { assert gbr_yri.size() > 0 },
                { assert gbr_yri.keySet() == yri_gbr.keySet() },
                { assert gbr_yri.every { junction, value -> (value + yri_gbr[junction]).abs() < 1e-6 } },
                { assert clear_genes.size() > 0 },
                { assert clear_genes.every { gene -> Math.signum(gene_logfc[gene]) == Math.signum(count_ratio[gene]) } },
                { assert snapshot(
                    workflow.out.counts,
                    workflow.out.settings,
                    workflow.out.gb_du.collect { meta, tsvs -> [ meta, tsvs.collect { tsv -> file(tsv).name } ] },
                    workflow.out.j_du.collect { meta, tsvs -> [ meta, tsvs.collect { tsv -> file(tsv).name } ] },
                    workflow.out.splicing_report.collect { meta, tsvs -> [ meta, tsvs.collect { tsv -> file(tsv).name } ] },
                    workflow.out.integrated_signals.collect { meta, tsv -> [ meta, file(tsv).name ] }
                ).match() }
            )
        }

    }

    test("homo_sapiens - condition missing from the samples") {

        when {
            workflow {
                """
                def samples = [ ERR188383:'GBR', ERR188428:'GBR', ERR188454:'YRI', ERR204916:'YRI' ]
                input[0] = channel.fromList(
                    samples.collect { id, condition -> [ [ id:id, condition:condition, single_end:false, strandedness:'unstranded' ], file(params.pipelines_testdata_base_path + "testdata/\${id}.Aligned.out.bam", checkIfExists: true) ] }
                )
                input[1] = channel.fromList(
                    samples.collect { id, condition -> [ [ id:id, condition:condition, single_end:false, strandedness:'unstranded' ], file(params.pipelines_testdata_base_path + "testdata/\${id}.Aligned.out.bam.bai", checkIfExists: true) ] }
                )
                input[2] = [ [ id:'genes_chrX' ], file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true) ]
                input[3] = channel.of(
                    [ contrast:'CEU-YRI', treatment:'CEU', control:'YRI' ],
                )
                input[4] = 0
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.errorReport.contains("ASpli contrast 'CEU-YRI': condition 'CEU' has no sample in the samplesheet") }
            )
        }

    }

    test("homo_sapiens - two contrasts - stub") {

        options "-stub"

        when {
            workflow {
                """
                def samples = [ ERR188383:'GBR', ERR188428:'GBR', ERR188454:'YRI', ERR204916:'YRI' ]
                input[0] = channel.fromList(
                    samples.collect { id, condition -> [ [ id:id, condition:condition, single_end:false, strandedness:'unstranded' ], file(params.pipelines_testdata_base_path + "testdata/\${id}.Aligned.out.bam", checkIfExists: true) ] }
                )
                input[1] = channel.fromList(
                    samples.collect { id, condition -> [ [ id:id, condition:condition, single_end:false, strandedness:'unstranded' ], file(params.pipelines_testdata_base_path + "testdata/\${id}.Aligned.out.bam.bai", checkIfExists: true) ] }
                )
                input[2] = [ [ id:'genes_chrX' ], file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true) ]
                input[3] = channel.of(
                    [ contrast:'GBR-YRI', treatment:'GBR', control:'YRI' ],
                    [ contrast:'YRI-GBR', treatment:'YRI', control:'GBR' ],
                )
                input[4] = 0
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }

    }

}
