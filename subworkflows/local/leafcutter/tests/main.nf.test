// nf-core subworkflows test leafcutter
nextflow_workflow {

    name "Test Subworkflow LEAFCUTTER"
    script "../main.nf"
    workflow "LEAFCUTTER"

    tag "subworkflows"
    tag "subworkflows/leafcutter"
    tag "regtools"
    tag "regtools/junctionsextract"
    tag "leafcutter"
    tag "leafcutter/clusterregtools"

    test("human chrX") {

        when {
            workflow {
                """
                input[0] = channel.of(
                    [ [ id:'ERR188383' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam', checkIfExists: true) ],
                    [ [ id:'ERR188428' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188428.Aligned.out.bam', checkIfExists: true) ],
                    [ [ id:'ERR188454' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188454.Aligned.out.bam', checkIfExists: true) ],
                    [ [ id:'ERR204916' ], file(params.pipelines_testdata_base_path + 'testdata/ERR204916.Aligned.out.bam', checkIfExists: true) ],
                )
                input[1] = channel.of(
                    [ [ id:'ERR188383' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam.bai', checkIfExists: true) ],
                    [ [ id:'ERR188428' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188428.Aligned.out.bam.bai', checkIfExists: true) ],
                    [ [ id:'ERR188454' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188454.Aligned.out.bam.bai', checkIfExists: true) ],
                    [ [ id:'ERR204916' ], file(params.pipelines_testdata_base_path + 'testdata/ERR204916.Aligned.out.bam.bai', checkIfExists: true) ],
                )
                """
            }
        }

        then {
            // `REGTOOLS_JUNCTIONSEXTRACT` runs once per sample, so `juncs` follows task
            // completion order and has to be sorted before it can be snapshotted. The
            // clustering outputs come from a single task and need no sorting.
            //
            // The clustering outputs snapshotted here are EMPTY, and that is a known bug,
            // not the expected result: `*_pooled` and `*_refined` are zero byte and the
            // counts tables hold a header and no rows. The test BAMs carry no `XS` tag, as
            // the pipeline does not run STAR with `--outSAMstrandField intronMotif`, so
            // regtools writes `?` in the strand column of every junction and
            // `leafcutter-cluster` discards them all. See #272. The junction files
            // themselves are real, so this snapshot does pin down everything up to the
            // clustering, and it will show the clusters appearing once #272 is fixed
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.juncs.sort { junc -> junc[0].id },
                    workflow.out.counts,
                    workflow.out.numers,
                    workflow.out.pooled,
                    workflow.out.refined,
                    workflow.out.sortedlibs
                ).match() }
            )
        }

    }

    test("human chrX - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of(
                    [ [ id:'ERR188383' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam', checkIfExists: true) ],
                    [ [ id:'ERR188428' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188428.Aligned.out.bam', checkIfExists: true) ],
                )
                input[1] = channel.of(
                    [ [ id:'ERR188383' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam.bai', checkIfExists: true) ],
                    [ [ id:'ERR188428' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188428.Aligned.out.bam.bai', checkIfExists: true) ],
                )
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.juncs.sort { junc -> junc[0].id },
                    workflow.out.counts,
                    workflow.out.numers,
                    workflow.out.pooled,
                    workflow.out.refined,
                    workflow.out.sortedlibs
                ).match() }
            )
        }

    }

}
