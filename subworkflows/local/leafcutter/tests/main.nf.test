// nf-core subworkflows test leafcutter
nextflow_workflow {

    name "Test Subworkflow LEAFCUTTER"
    script "../main.nf"
    workflow "LEAFCUTTER"

    tag "subworkflows"
    tag "subworkflows/leafcutter"
    tag "regtools"
    tag "regtools/junctionsextract"
    tag "leafcutter"
    tag "leafcutter/clusterregtools"
    tag "leafcutter/differentialsplicing"
    tag "leafcutter/gtftoexons"
    tag "strandjunctions"
    tag "gunzip"
    tag "samtools"
    tag "samtools/faidx"

    test("human chrX") {

        setup {
            run("GUNZIP") {
                script "../../../../modules/nf-core/gunzip/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [ id:'genome' ],
                        file(params.pipelines_testdata_base_path + 'reference/X.fa.gz', checkIfExists: true)
                    ])
                    """
                }
            }

            run("SAMTOOLS_FAIDX") {
                script "../../../../modules/nf-core/samtools/faidx/main.nf"
                process {
                    """
                    input[0] = GUNZIP.out.gunzip.map { meta, fasta -> [ meta, fasta, [] ] }
                    input[1] = false
                    """
                }
            }
        }

        when {
            params {
                // Two samples per condition, fewer than leafcutter-ds asks for by default,
                // and a single cluster of a few reads per sample, which leafcutter-ds only
                // tests with a lower coverage threshold
                leafcutter_ds_min_samples_per_intron = 2
                leafcutter_ds_min_samples_per_group = 2
                leafcutter_ds_min_coverage = 1
            }
            workflow {
                """
                input[0] = channel.of(
                    [ [ id:'ERR188383', strandedness:'unstranded', condition:'GBR' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam', checkIfExists: true) ],
                    [ [ id:'ERR188428', strandedness:'unstranded', condition:'GBR' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188428.Aligned.out.bam', checkIfExists: true) ],
                    [ [ id:'ERR188454', strandedness:'unstranded', condition:'YRI' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188454.Aligned.out.bam', checkIfExists: true) ],
                    [ [ id:'ERR204916', strandedness:'unstranded', condition:'YRI' ], file(params.pipelines_testdata_base_path + 'testdata/ERR204916.Aligned.out.bam', checkIfExists: true) ],
                )
                input[1] = channel.of(
                    [ [ id:'ERR188383', strandedness:'unstranded', condition:'GBR' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam.bai', checkIfExists: true) ],
                    [ [ id:'ERR188428', strandedness:'unstranded', condition:'GBR' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188428.Aligned.out.bam.bai', checkIfExists: true) ],
                    [ [ id:'ERR188454', strandedness:'unstranded', condition:'YRI' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188454.Aligned.out.bam.bai', checkIfExists: true) ],
                    [ [ id:'ERR204916', strandedness:'unstranded', condition:'YRI' ], file(params.pipelines_testdata_base_path + 'testdata/ERR204916.Aligned.out.bam.bai', checkIfExists: true) ],
                )
                input[2] = GUNZIP.out.gunzip.join(SAMTOOLS_FAIDX.out.fai).first()
                input[3] = channel.value([
                    [ id:'genome' ],
                    file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true)
                ])
                input[4] = channel.of([ contrast:'GBR-YRI', treatment:'GBR', control:'YRI' ])
                input[5] = 2
                """
            }
        }

        then {
            // `REGTOOLS_JUNCTIONSEXTRACT` runs once per sample, so `juncs` follows task
            // completion order and has to be sorted before it can be snapshotted. The
            // clustering outputs come from a single task and need no sorting.
            //
            // These BAM files carry no `XS` tag, so regtools leaves every junction
            // strandless and it is `STRANDJUNCTIONS` that gives them a strand, from the
            // splice motif in the genome and from the annotation. The clusters below are
            // what that produces; `tests/leafcutter.nf.test` covers the same path from fastq
            assertAll(
                { assert workflow.success },
                { assert path(workflow.out.pooled[0][1]).size() > 0 },
                { assert path(workflow.out.refined[0][1]).size() > 0 },
                { assert snapshot(
                    workflow.out.juncs.sort { junc -> junc[0].id },
                    workflow.out.counts,
                    workflow.out.numers,
                    workflow.out.pooled,
                    workflow.out.refined,
                    workflow.out.sortedlibs,
                    workflow.out.exons,
                    // The statistics of leafcutter-ds differ between machines, so only the
                    // ids, test status, degrees of freedom and genes are snapshotted
                    workflow.out.cluster_significance.collect { meta, txt -> [ meta, LeafcutterDsTable.stable(txt) ] },
                    workflow.out.effect_sizes.collect { meta, txt -> [ meta, LeafcutterDsTable.stable(txt) ] }
                ).match() }
            )
        }

    }

    test("human chrX - reverse stranded") {

        when {
            params {
                // Two samples per condition, fewer than leafcutter-ds asks for by default,
                // and a single cluster of a few reads per sample, which leafcutter-ds only
                // tests with a lower coverage threshold
                leafcutter_ds_min_samples_per_intron = 2
                leafcutter_ds_min_samples_per_group = 2
                leafcutter_ds_min_coverage = 1
            }
            workflow {
                """
                input[0] = channel.of(
                    [ [ id:'ERR188383', strandedness:'reverse', condition:'GBR' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188383_reverse.Aligned.out.bam', checkIfExists: true) ],
                    [ [ id:'ERR188428', strandedness:'reverse', condition:'GBR' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188428_reverse.Aligned.out.bam', checkIfExists: true) ],
                    [ [ id:'ERR188454', strandedness:'reverse', condition:'YRI' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188454_reverse.Aligned.out.bam', checkIfExists: true) ],
                    [ [ id:'ERR204916', strandedness:'reverse', condition:'YRI' ], file(params.pipelines_testdata_base_path + 'testdata/ERR204916_reverse.Aligned.out.bam', checkIfExists: true) ],
                )
                input[1] = channel.of(
                    [ [ id:'ERR188383', strandedness:'reverse', condition:'GBR' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188383_reverse.Aligned.out.bam.bai', checkIfExists: true) ],
                    [ [ id:'ERR188428', strandedness:'reverse', condition:'GBR' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188428_reverse.Aligned.out.bam.bai', checkIfExists: true) ],
                    [ [ id:'ERR188454', strandedness:'reverse', condition:'YRI' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188454_reverse.Aligned.out.bam.bai', checkIfExists: true) ],
                    [ [ id:'ERR204916', strandedness:'reverse', condition:'YRI' ], file(params.pipelines_testdata_base_path + 'testdata/ERR204916_reverse.Aligned.out.bam.bai', checkIfExists: true) ],
                )
                // A stranded sample takes its strand from the read orientation, so
                // `STRANDJUNCTIONS` never runs and needs no genome. The annotation is still
                // what the exon table of the differential splicing comes from
                input[2] = channel.value([ [ id:'genome' ], [], [] ])
                input[3] = channel.value([
                    [ id:'genome' ],
                    file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true)
                ])
                input[4] = channel.of([ contrast:'GBR-YRI', treatment:'GBR', control:'YRI' ])
                input[5] = 2
                """
            }
        }

        then {
            // The reverse stranded versions of the GEUVADIS reads, so regtools reads the
            // strand off the read orientation. This is the stranded path, the one
            // `--source genome_bam` depends on: the junctions reach `leafcutter-cluster`
            // with a strand without any `XS` tag, and the clustering outputs come back non empty
            assertAll(
                { assert workflow.success },
                { assert path(workflow.out.pooled[0][1]).size() > 0 },
                { assert path(workflow.out.refined[0][1]).size() > 0 },
                { assert snapshot(
                    workflow.out.juncs.sort { junc -> junc[0].id },
                    workflow.out.counts,
                    workflow.out.numers,
                    workflow.out.pooled,
                    workflow.out.refined,
                    workflow.out.sortedlibs,
                    workflow.out.exons,
                    // The statistics of leafcutter-ds differ between machines, so only the
                    // ids, test status, degrees of freedom and genes are snapshotted
                    workflow.out.cluster_significance.collect { meta, txt -> [ meta, LeafcutterDsTable.stable(txt) ] },
                    workflow.out.effect_sizes.collect { meta, txt -> [ meta, LeafcutterDsTable.stable(txt) ] }
                ).match() }
            )
        }

    }

    test("human chrX - leafcutter_max_intron_len") {

        when {
            params {
                leafcutter_max_intron_len = 100000
            }
            workflow {
                """
                input[0] = channel.of(
                    [ [ id:'ERR188383', strandedness:'reverse', condition:'GBR' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188383_reverse.Aligned.out.bam', checkIfExists: true) ],
                    [ [ id:'ERR188428', strandedness:'reverse', condition:'YRI' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188428_reverse.Aligned.out.bam', checkIfExists: true) ],
                )
                input[1] = channel.of(
                    [ [ id:'ERR188383', strandedness:'reverse', condition:'GBR' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188383_reverse.Aligned.out.bam.bai', checkIfExists: true) ],
                    [ [ id:'ERR188428', strandedness:'reverse', condition:'YRI' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188428_reverse.Aligned.out.bam.bai', checkIfExists: true) ],
                )
                input[2] = channel.value([ [ id:'genome' ], [], [] ])
                input[3] = channel.value([
                    [ id:'genome' ],
                    file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true)
                ])
                input[4] = channel.of([ contrast:'GBR-YRI', treatment:'GBR', control:'YRI' ])
                input[5] = 2
                """
            }
        }

        then {
            def scripts = []
            new File(workDir.toString()).eachFileRecurse { file ->
                if (file.name == '.command.sh') {
                    scripts << file.text
                }
            }
            def regtools = scripts.findAll { script -> script.contains('regtools junctions extract') }
            def cluster = scripts.findAll { script -> script.contains('leafcutter-cluster') }
            // One sample per condition is fewer than `min_samples_per_condition`, so the
            // contrast is left out of the differential splicing with a warning
            def ds = scripts.findAll { script -> script.contains('leafcutter-ds') }
            assertAll(
                { assert workflow.success },
                { assert regtools.size() == 2 },
                { assert regtools.every { script -> script.contains('-a 8 -m 50 -M 100000') } },
                { assert cluster.size() == 1 },
                { assert cluster[0].contains('-l 100000 -m 10 -p 0.001') },
                { assert ds.size() == 0 },
                { assert workflow.out.cluster_significance.size() == 0 },
                { assert file("${outputDir}/../meta/nextflow.log").text.contains("LeafCutter contrast 'GBR-YRI' is not tested for differential splicing") }
            )
        }

    }

    test("human chrX - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of(
                    [ [ id:'ERR188383', strandedness:'unstranded', condition:'GBR' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam', checkIfExists: true) ],
                    [ [ id:'ERR188428', strandedness:'unstranded', condition:'YRI' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188428.Aligned.out.bam', checkIfExists: true) ],
                )
                input[1] = channel.of(
                    [ [ id:'ERR188383', strandedness:'unstranded', condition:'GBR' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam.bai', checkIfExists: true) ],
                    [ [ id:'ERR188428', strandedness:'unstranded', condition:'YRI' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188428.Aligned.out.bam.bai', checkIfExists: true) ],
                )
                input[2] = channel.value([ [ id:'genome' ], [], [] ])
                input[3] = channel.value([
                    [ id:'genome' ],
                    file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true)
                ])
                input[4] = channel.of([ contrast:'GBR-YRI', treatment:'GBR', control:'YRI' ])
                input[5] = 1
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.juncs.sort { junc -> junc[0].id },
                    workflow.out.counts,
                    workflow.out.numers,
                    workflow.out.pooled,
                    workflow.out.refined,
                    workflow.out.sortedlibs,
                    workflow.out.exons,
                    workflow.out.cluster_significance,
                    workflow.out.effect_sizes
                ).match() }
            )
        }

    }

}
