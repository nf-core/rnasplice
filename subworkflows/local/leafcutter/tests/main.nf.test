// nf-core subworkflows test leafcutter
nextflow_workflow {

    name "Test Subworkflow LEAFCUTTER"
    script "../main.nf"
    workflow "LEAFCUTTER"

    tag "subworkflows"
    tag "subworkflows/leafcutter"
    tag "regtools"
    tag "regtools/junctionsextract"
    tag "leafcutter"
    tag "leafcutter/clusterregtools"
    tag "strandjunctions"
    tag "gunzip"
    tag "samtools"
    tag "samtools/faidx"

    test("human chrX") {

        setup {
            run("GUNZIP") {
                script "../../../../modules/nf-core/gunzip/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [ id:'genome' ],
                        file(params.pipelines_testdata_base_path + 'reference/X.fa.gz', checkIfExists: true)
                    ])
                    """
                }
            }

            run("SAMTOOLS_FAIDX") {
                script "../../../../modules/nf-core/samtools/faidx/main.nf"
                process {
                    """
                    input[0] = GUNZIP.out.gunzip.map { meta, fasta -> [ meta, fasta, [] ] }
                    input[1] = false
                    """
                }
            }
        }

        when {
            workflow {
                """
                input[0] = channel.of(
                    [ [ id:'ERR188383', strandedness:'unstranded' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam', checkIfExists: true) ],
                    [ [ id:'ERR188428', strandedness:'unstranded' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188428.Aligned.out.bam', checkIfExists: true) ],
                    [ [ id:'ERR188454', strandedness:'unstranded' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188454.Aligned.out.bam', checkIfExists: true) ],
                    [ [ id:'ERR204916', strandedness:'unstranded' ], file(params.pipelines_testdata_base_path + 'testdata/ERR204916.Aligned.out.bam', checkIfExists: true) ],
                )
                input[1] = channel.of(
                    [ [ id:'ERR188383', strandedness:'unstranded' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam.bai', checkIfExists: true) ],
                    [ [ id:'ERR188428', strandedness:'unstranded' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188428.Aligned.out.bam.bai', checkIfExists: true) ],
                    [ [ id:'ERR188454', strandedness:'unstranded' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188454.Aligned.out.bam.bai', checkIfExists: true) ],
                    [ [ id:'ERR204916', strandedness:'unstranded' ], file(params.pipelines_testdata_base_path + 'testdata/ERR204916.Aligned.out.bam.bai', checkIfExists: true) ],
                )
                input[2] = GUNZIP.out.gunzip.join(SAMTOOLS_FAIDX.out.fai).first()
                input[3] = channel.value([
                    [ id:'genome' ],
                    file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true)
                ])
                """
            }
        }

        then {
            // `REGTOOLS_JUNCTIONSEXTRACT` runs once per sample, so `juncs` follows task
            // completion order and has to be sorted before it can be snapshotted. The
            // clustering outputs come from a single task and need no sorting.
            //
            // These BAM files carry no `XS` tag, so regtools leaves every junction
            // strandless and it is `STRANDJUNCTIONS` that gives them a strand, from the
            // splice motif in the genome and from the annotation. The clusters below are
            // what that produces; `tests/leafcutter.nf.test` covers the same path from fastq
            assertAll(
                { assert workflow.success },
                { assert path(workflow.out.pooled[0][1]).size() > 0 },
                { assert path(workflow.out.refined[0][1]).size() > 0 },
                { assert snapshot(
                    workflow.out.juncs.sort { junc -> junc[0].id },
                    workflow.out.counts,
                    workflow.out.numers,
                    workflow.out.pooled,
                    workflow.out.refined,
                    workflow.out.sortedlibs
                ).match() }
            )
        }

    }

    test("human chrX - reverse stranded") {

        when {
            workflow {
                """
                input[0] = channel.of(
                    [ [ id:'ERR188383', strandedness:'reverse' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188383_reverse.Aligned.out.bam', checkIfExists: true) ],
                    [ [ id:'ERR188428', strandedness:'reverse' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188428_reverse.Aligned.out.bam', checkIfExists: true) ],
                    [ [ id:'ERR188454', strandedness:'reverse' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188454_reverse.Aligned.out.bam', checkIfExists: true) ],
                    [ [ id:'ERR204916', strandedness:'reverse' ], file(params.pipelines_testdata_base_path + 'testdata/ERR204916_reverse.Aligned.out.bam', checkIfExists: true) ],
                )
                input[1] = channel.of(
                    [ [ id:'ERR188383', strandedness:'reverse' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188383_reverse.Aligned.out.bam.bai', checkIfExists: true) ],
                    [ [ id:'ERR188428', strandedness:'reverse' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188428_reverse.Aligned.out.bam.bai', checkIfExists: true) ],
                    [ [ id:'ERR188454', strandedness:'reverse' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188454_reverse.Aligned.out.bam.bai', checkIfExists: true) ],
                    [ [ id:'ERR204916', strandedness:'reverse' ], file(params.pipelines_testdata_base_path + 'testdata/ERR204916_reverse.Aligned.out.bam.bai', checkIfExists: true) ],
                )
                // A stranded sample takes its strand from the read orientation, so
                // `STRANDJUNCTIONS` never runs and needs no genome
                input[2] = channel.value([ [ id:'genome' ], [], [] ])
                input[3] = channel.value([ [ id:'genome' ], [] ])
                """
            }
        }

        then {
            // The reverse stranded versions of the GEUVADIS reads, so regtools reads the
            // strand off the read orientation. This is the stranded path, the one
            // `--source genome_bam` depends on: the junctions reach `leafcutter-cluster`
            // with a strand without any `XS` tag, and the clustering outputs come back non empty
            assertAll(
                { assert workflow.success },
                { assert path(workflow.out.pooled[0][1]).size() > 0 },
                { assert path(workflow.out.refined[0][1]).size() > 0 },
                { assert snapshot(
                    workflow.out.juncs.sort { junc -> junc[0].id },
                    workflow.out.counts,
                    workflow.out.numers,
                    workflow.out.pooled,
                    workflow.out.refined,
                    workflow.out.sortedlibs
                ).match() }
            )
        }

    }

    test("human chrX - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of(
                    [ [ id:'ERR188383', strandedness:'unstranded' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam', checkIfExists: true) ],
                    [ [ id:'ERR188428', strandedness:'unstranded' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188428.Aligned.out.bam', checkIfExists: true) ],
                )
                input[1] = channel.of(
                    [ [ id:'ERR188383', strandedness:'unstranded' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam.bai', checkIfExists: true) ],
                    [ [ id:'ERR188428', strandedness:'unstranded' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188428.Aligned.out.bam.bai', checkIfExists: true) ],
                )
                input[2] = channel.value([ [ id:'genome' ], [], [] ])
                input[3] = channel.value([ [ id:'genome' ], [] ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.juncs.sort { junc -> junc[0].id },
                    workflow.out.counts,
                    workflow.out.numers,
                    workflow.out.pooled,
                    workflow.out.refined,
                    workflow.out.sortedlibs
                ).match() }
            )
        }

    }

}
