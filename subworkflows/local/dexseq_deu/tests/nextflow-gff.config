includeConfig 'nextflow.config'

// `DEXSEQ_DEU` skips `DEXSEQ_ANNOTATION` when the user supplies their own DEXSeq GFF.
// The subworkflow only reads `params.gff_dexseq` as a flag, the annotation itself is
// passed through `ch_dexseq_gff`, so any truthy value selects that branch here.
params {
    gff_dexseq = 'DEXSeq.gff'
}
