nextflow_workflow {

    name "Test Subworkflow PIPELINE_INITIALISATION"
    script "../main.nf"
    workflow "PIPELINE_INITIALISATION"

    tag "subworkflows"
    tag "subworkflows/utils_nfcore_rnasplice_pipeline"

    // BAM samplesheets carry optional strandedness and single_end columns, which have to
    // reach the meta map of every sample so that the tools that need the library type and
    // the read type get them, and which default to unstranded and paired end, see
    // https://github.com/nf-core/rnasplice/issues/184

    setup {
        def testdata = 'https://raw.githubusercontent.com/nf-core/test-datasets/rnasplice/chrX_subset/testdata/'
        def samples = [ 'ERR188383': 'GBR', 'ERR188428': 'GBR', 'ERR188454': 'YRI', 'ERR204916': 'YRI' ]

        def genome_bam = new File("${launchDir}/samplesheet_genome_bam_optional_columns.csv")
        genome_bam.parentFile.mkdirs()
        genome_bam.text = "sample,condition,strandedness,single_end,genome_bam\n" + samples.collect { sample, condition ->
            "${sample},${condition},reverse,true,${testdata}${sample}.Aligned.out.bam\n"
        }.join()

        def genome_bam_defaults = new File("${launchDir}/samplesheet_genome_bam.csv")
        genome_bam_defaults.text = "sample,condition,genome_bam\n" + samples.collect { sample, condition ->
            "${sample},${condition},${testdata}${sample}.Aligned.out.bam\n"
        }.join()

        def transcriptome_bam = new File("${launchDir}/samplesheet_transcriptome_bam_optional_columns.csv")
        transcriptome_bam.text = "sample,condition,strandedness,single_end,genome_bam,transcriptome_bam\n" + samples.collect { sample, condition ->
            "${sample},${condition},forward,true,${testdata}${sample}.Aligned.out.bam,${testdata}${sample}.Aligned.toTranscriptome.out.bam\n"
        }.join()

        // As written by nf-core/rnaseq with --save_align_intermeds, plus a condition column,
        // with a second sequencing run for the first sample
        def rnaseq_header = "sample,fastq_1,fastq_2,strandedness,seq_platform,seq_center,genome_bam,percent_mapped,transcriptome_bam,condition\n"
        def rnaseq_row = { sample, condition, run ->
            "${sample},${testdata}${sample}_chrX_1.fastq.gz,${testdata}${sample}_chrX_2.fastq.gz,reverse,ILLUMINA,${run},${testdata}${sample}.Aligned.out.bam,95.5,${testdata}${sample}.Aligned.toTranscriptome.out.bam,${condition}\n"
        }
        new File("${launchDir}/samplesheet_rnaseq_bams.csv").text = rnaseq_header +
            rnaseq_row('ERR188383', 'GBR', 'RUN2') + samples.collect { sample, condition -> rnaseq_row(sample, condition, 'RUN1') }.join()

        new File("${launchDir}/samplesheet_partial_genome_bam.csv").text = "sample,condition,genome_bam\n" + samples.collect { sample, condition ->
            "${sample},${condition},${sample == 'ERR204916' ? '' : testdata + sample + '.Aligned.out.bam'}\n"
        }.join()

        new File("${launchDir}/samplesheet_transcriptome_bam_salmon_results.csv").text = "sample,condition,transcriptome_bam,salmon_results\n" + samples.collect { sample, condition ->
            "${sample},${condition},${testdata}${sample}.Aligned.toTranscriptome.out.bam,${testdata}${sample}.tar.gz\n"
        }.join()

        new File("${launchDir}/samplesheet_conflicting_runs.csv").text = "sample,condition,genome_bam\n" + samples.collect { sample, condition ->
            "${sample},${condition},${testdata}${sample}.Aligned.out.bam\n"
        }.join() + "ERR188383,GBR,${testdata}ERR188428.Aligned.out.bam\n"

        new File("${launchDir}/samplesheet_no_input.csv").text = "sample,condition,strandedness\n" + samples.collect { sample, condition ->
            "${sample},${condition},unstranded\n"
        }.join()

        def contrasts = [
            'contrastsheet_legacy.csv'         : "contrast,treatment,control\nGBR-YRI,GBR,YRI\n",
            'contrastsheet_new.csv'            : "id,variable,reference,target\nGBR-YRI,condition,YRI,GBR\n",
            'contrastsheet_new_blocking.csv'   : "id,variable,reference,target,blocking\nGBR-YRI,condition,YRI,GBR,batch\n",
            'contrastsheet_mixed.csv'          : "id,variable,reference,treatment\nGBR-YRI,condition,YRI,GBR\n",
            'contrastsheet_variable.csv'       : "id,variable,reference,target\nGBR-YRI,batch,YRI,GBR\n",
            'contrastsheet_missing_target.csv' : "id,variable,reference,target\nGBR-YRI,condition,YRI,\n",
            'contrastsheet_dup_id.csv'         : "id,variable,reference,target\nGBR-YRI,condition,YRI,GBR\nGBR-YRI,condition,GBR,YRI\n",
            'contrastsheet_dup_legacy.csv'     : "contrast,treatment,control\nGBR-YRI,GBR,YRI\nGBR-YRI,YRI,GBR\n",
        ]
        contrasts.each { name, content -> new File("${launchDir}/${name}").text = content }
    }

    test("genome_bam - strandedness and read type") {

        when {
            workflow {
                """
                input[0] = false                                                                    // version
                input[1] = false                                                                    // validate_params
                input[2] = true                                                                     // monochrome_logs
                input[3] = []                                                                       // nextflow_cli_args
                input[4] = "${outputDir}"                                                           // outdir
                input[5] = "${launchDir}/samplesheet_genome_bam_optional_columns.csv"               // input
                input[6] = params.pipelines_testdata_base_path + 'samplesheet/contrastsheet.csv'    // contrasts
                input[7] = false                                                                    // help
                input[8] = false                                                                    // help_full
                input[9] = false                                                                   // show_hidden
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.samplesheet.size() == 4 },
                { assert workflow.out.samplesheet.every { row -> row[0].strandedness == 'reverse' } },
                { assert workflow.out.samplesheet.every { row -> row[0].single_end } },
                { assert workflow.out.samplesheet.every { row -> row[2].endsWith('.Aligned.out.bam') && row[3] == null } }
            )
        }

    }

    test("genome_bam - no optional columns") {

        when {
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = "${outputDir}"
                input[5] = "${launchDir}/samplesheet_genome_bam.csv"
                input[6] = params.pipelines_testdata_base_path + 'samplesheet/contrastsheet.csv'
                input[7] = false
                input[8] = false
                input[9] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.samplesheet.size() == 4 },
                { assert workflow.out.samplesheet.every { row -> row[0].strandedness == 'unstranded' } },
                { assert workflow.out.samplesheet.every { row -> !row[0].single_end } },
                // The modules reading the sheet get the sample and condition only
                { assert new File(workflow.out.samplesheet_file[0].toString()).readLines() == [ 'sample,condition', 'ERR188383,GBR', 'ERR188428,GBR', 'ERR188454,YRI', 'ERR204916,YRI' ] }
            )
        }

    }

    test("genome_bam and transcriptome_bam - strandedness and read type") {

        when {
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = "${outputDir}"
                input[5] = "${launchDir}/samplesheet_transcriptome_bam_optional_columns.csv"
                input[6] = params.pipelines_testdata_base_path + 'samplesheet/contrastsheet.csv'
                input[7] = false
                input[8] = false
                input[9] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.samplesheet.size() == 4 },
                { assert workflow.out.samplesheet.every { row -> row[0].strandedness == 'forward' } },
                { assert workflow.out.samplesheet.every { row -> row[0].single_end } },
                { assert workflow.out.samplesheet.every { row -> row[2].endsWith('.Aligned.out.bam') && row[3].endsWith('.Aligned.toTranscriptome.out.bam') } }
            )
        }

    }

    test("rnaseq samplesheet_with_bams.csv - BAMs, FASTQ runs and extra columns") {

        when {
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = "${outputDir}"
                input[5] = "${launchDir}/samplesheet_rnaseq_bams.csv"
                input[6] = params.pipelines_testdata_base_path + 'samplesheet/contrastsheet.csv'
                input[7] = false
                input[8] = false
                input[9] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.samplesheet.size() == 4 },
                { assert workflow.out.samplesheet.every { row -> row[0].keySet() == [ 'id', 'condition', 'strandedness', 'single_end' ] as Set } },
                { assert workflow.out.samplesheet.every { row -> row[0].strandedness == 'reverse' && !row[0].single_end } },
                // Both runs of ERR188383 are kept for concatenation, its BAM files once
                { assert workflow.out.samplesheet.find { row -> row[0].id == 'ERR188383' }[1].size() == 4 },
                { assert workflow.out.samplesheet.every { row -> row[2].endsWith('.Aligned.out.bam') && row[3].endsWith('.Aligned.toTranscriptome.out.bam') && row[4] == null } },
                { assert new File(workflow.out.samplesheet_file[0].toString()).readLines() == [ 'sample,condition', 'ERR188383,GBR', 'ERR188428,GBR', 'ERR188454,YRI', 'ERR204916,YRI' ] }
            )
        }

    }

    test("partly filled BAM column fails") {

        when {
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = "${outputDir}"
                input[5] = "${launchDir}/samplesheet_partial_genome_bam.csv"
                input[6] = params.pipelines_testdata_base_path + 'samplesheet/contrastsheet.csv'
                input[7] = false
                input[8] = false
                input[9] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { line -> line.contains("The 'genome_bam' column must be filled for every sample or for none") } }
            )
        }

    }

    test("transcriptome_bam with salmon_results fails") {

        when {
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = "${outputDir}"
                input[5] = "${launchDir}/samplesheet_transcriptome_bam_salmon_results.csv"
                input[6] = params.pipelines_testdata_base_path + 'samplesheet/contrastsheet.csv'
                input[7] = false
                input[8] = false
                input[9] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { line -> line.contains("The 'transcriptome_bam' and 'salmon_results' columns cannot both be given") } }
            )
        }

    }

    test("runs of a sample with different BAM files fail") {

        when {
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = "${outputDir}"
                input[5] = "${launchDir}/samplesheet_conflicting_runs.csv"
                input[6] = params.pipelines_testdata_base_path + 'samplesheet/contrastsheet.csv'
                input[7] = false
                input[8] = false
                input[9] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { line -> line.contains("Multiple rows of a sample must give the same 'genome_bam': ERR188383") } }
            )
        }

    }

    test("sample without input fails") {

        when {
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = "${outputDir}"
                input[5] = "${launchDir}/samplesheet_no_input.csv"
                input[6] = params.pipelines_testdata_base_path + 'samplesheet/contrastsheet.csv'
                input[7] = false
                input[8] = false
                input[9] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { line -> line.contains("Each sample needs at least one of") } }
            )
        }

    }

    test("--source is deprecated") {

        when {
            params {
                source = 'genome_bam'
            }
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = "${outputDir}"
                input[5] = "${launchDir}/samplesheet_genome_bam.csv"
                input[6] = params.pipelines_testdata_base_path + 'samplesheet/contrastsheet.csv'
                input[7] = false
                input[8] = false
                input[9] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert (workflow.stdout + workflow.stderr).any { line -> line.contains("The '--source' parameter is deprecated and ignored") } }
            )
        }

    }

    test("contrastsheet - legacy header") {

        when {
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = "${outputDir}"
                input[5] = "${launchDir}/samplesheet_genome_bam.csv"
                input[6] = "${launchDir}/contrastsheet_legacy.csv"
                input[7] = false
                input[8] = false
                input[9] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.contrastsheet.size() == 1 },
                { assert workflow.out.contrastsheet[0] == [ contrast: 'GBR-YRI', treatment: 'GBR', control: 'YRI' ] },
                { assert new File(workflow.out.contrastsheet_file[0].toString()).readLines() == [ 'contrast,treatment,control', 'GBR-YRI,GBR,YRI' ] }
            )
        }

    }

    test("contrastsheet - new header") {

        when {
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = "${outputDir}"
                input[5] = "${launchDir}/samplesheet_genome_bam.csv"
                input[6] = "${launchDir}/contrastsheet_new.csv"
                input[7] = false
                input[8] = false
                input[9] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.contrastsheet.size() == 1 },
                // reference is the control and target the treatment, so the contrast is GBR over YRI
                { assert workflow.out.contrastsheet[0] == [ contrast: 'GBR-YRI', treatment: 'GBR', control: 'YRI' ] },
                // The modules reading the sheet get the legacy header
                { assert new File(workflow.out.contrastsheet_file[0].toString()).readLines() == [ 'contrast,treatment,control', 'GBR-YRI,GBR,YRI' ] }
            )
        }

    }

    test("contrastsheet - blocking is ignored") {

        when {
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = "${outputDir}"
                input[5] = "${launchDir}/samplesheet_genome_bam.csv"
                input[6] = "${launchDir}/contrastsheet_new_blocking.csv"
                input[7] = false
                input[8] = false
                input[9] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // The blocking column is ignored, with a warning in the Nextflow log
                { assert workflow.out.contrastsheet[0] == [ contrast: 'GBR-YRI', treatment: 'GBR', control: 'YRI' ] }
            )
        }

    }

    // The schema rejects these sheets, with the details in the Nextflow log
    test("contrastsheet - mixed headers fail") {

        when {
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = "${outputDir}"
                input[5] = "${launchDir}/samplesheet_genome_bam.csv"
                input[6] = "${launchDir}/contrastsheet_mixed.csv"
                input[7] = false
                input[8] = false
                input[9] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains("Validation of samplesheet failed") } }
            )
        }

    }

    test("contrastsheet - unsupported variable fails") {

        when {
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = "${outputDir}"
                input[5] = "${launchDir}/samplesheet_genome_bam.csv"
                input[6] = "${launchDir}/contrastsheet_variable.csv"
                input[7] = false
                input[8] = false
                input[9] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains("Validation of samplesheet failed") } }
            )
        }

    }

    test("contrastsheet - missing value fails") {

        when {
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = "${outputDir}"
                input[5] = "${launchDir}/samplesheet_genome_bam.csv"
                input[6] = "${launchDir}/contrastsheet_missing_target.csv"
                input[7] = false
                input[8] = false
                input[9] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains("Validation of samplesheet failed") } }
            )
        }

    }

    test("contrastsheet - duplicate id fails") {

        when {
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = "${outputDir}"
                input[5] = "${launchDir}/samplesheet_genome_bam.csv"
                input[6] = "${launchDir}/contrastsheet_dup_id.csv"
                input[7] = false
                input[8] = false
                input[9] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains("Validation of samplesheet failed") } },
                { assert (workflow.stdout + workflow.stderr).any { it.contains("Detected duplicate entries: [id:GBR-YRI]") } }
            )
        }

    }

    test("contrastsheet - duplicate legacy contrast fails") {

        when {
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = "${outputDir}"
                input[5] = "${launchDir}/samplesheet_genome_bam.csv"
                input[6] = "${launchDir}/contrastsheet_dup_legacy.csv"
                input[7] = false
                input[8] = false
                input[9] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains("Validation of samplesheet failed") } },
                { assert (workflow.stdout + workflow.stderr).any { it.contains("Detected duplicate entries: [contrast:GBR-YRI]") } }
            )
        }

    }

}
