nextflow_workflow {

    name "Test Subworkflow PIPELINE_INITIALISATION"
    script "../main.nf"
    workflow "PIPELINE_INITIALISATION"
    config "./nextflow.config"

    tag "subworkflows"
    tag "subworkflows/utils_nfcore_rnasplice_pipeline"

    setup {
        def testdata = 'https://raw.githubusercontent.com/nf-core/test-datasets/rnasplice/chrX_subset/testdata/'
        def samples = [ 'ERR188383': 'GBR', 'ERR188428': 'GBR', 'ERR188454': 'YRI', 'ERR204916': 'YRI' ]

        // Quoted column names, as spreadsheet tools write them
        def genome_bam_blocking = new File("${launchDir}/samplesheet_genome_bam_blocking.csv")
        genome_bam_blocking.parentFile.mkdirs()
        genome_bam_blocking.text = '"sample","condition","batch","genome_bam"\n' + samples.collect { sample, condition ->
            "${sample},${condition},\"${sample in ['ERR188383', 'ERR188454'] ? 'b 1' : 'b,2'}\",${testdata}${sample}.Aligned.out.bam\n"
        }.join()

        // Every sample has the same batch, and a batch that is the condition
        def genome_bam_constant = new File("${launchDir}/samplesheet_genome_bam_constant.csv")
        genome_bam_constant.text = 'sample,condition,batch,genome_bam\n' + samples.collect { sample, condition ->
            "${sample},${condition},1,${testdata}${sample}.Aligned.out.bam\n"
        }.join()
        def genome_bam_confounded = new File("${launchDir}/samplesheet_genome_bam_confounded.csv")
        genome_bam_confounded.text = 'sample,condition,batch,genome_bam\n' + samples.collect { sample, condition ->
            "${sample},${condition},${condition},${testdata}${sample}.Aligned.out.bam\n"
        }.join()

        def contrasts = [
            'contrastsheet_legacy.csv'         : "contrast,treatment,control\nGBR-YRI,GBR,YRI\n",
            'contrastsheet_new.csv'            : "id,variable,reference,target\nGBR-YRI,condition,YRI,GBR\n",
            'contrastsheet_new_blocking.csv'   : "id,variable,reference,target,blocking\nGBR-YRI,condition,YRI,GBR,batch\nYRI-GBR,condition,GBR,YRI,NA\n",
            'contrastsheet_mixed.csv'          : "id,variable,reference,treatment\nGBR-YRI,condition,YRI,GBR\n",
            'contrastsheet_variable.csv'       : "id,variable,reference,target\nGBR-YRI,batch,YRI,GBR\n",
            'contrastsheet_missing_target.csv' : "id,variable,reference,target\nGBR-YRI,condition,YRI,\n",
            'contrastsheet_dup_id.csv'         : "id,variable,reference,target\nGBR-YRI,condition,YRI,GBR\nGBR-YRI,condition,GBR,YRI\n",
            'contrastsheet_dup_legacy.csv'     : "contrast,treatment,control\nGBR-YRI,GBR,YRI\nGBR-YRI,YRI,GBR\n",
        ]
        contrasts.each { name, content -> new File("${launchDir}/${name}").text = content }
    }

    test("--source is deprecated") {

        when {
            params {
                source = 'genome_bam'
            }
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = "${outputDir}"
                input[5] = params.pipelines_testdata_base_path + 'samplesheet/samplesheet_bam.csv'
                input[6] = params.pipelines_testdata_base_path + 'samplesheet/contrastsheet.csv'
                input[7] = false
                input[8] = false
                input[9] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Warnings go to the Nextflow log rather than the console
                { assert path("${outputDir}/../meta/nextflow.log").text.contains("The '--source' parameter is deprecated and ignored") }
            )
        }

    }

    test("contrastsheet - legacy header") {

        when {
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = "${outputDir}"
                input[5] = params.pipelines_testdata_base_path + 'samplesheet/samplesheet_bam.csv'
                input[6] = "${launchDir}/contrastsheet_legacy.csv"
                input[7] = false
                input[8] = false
                input[9] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.contrastsheet.size() == 1 },
                { assert workflow.out.contrastsheet[0] == [ contrast: 'GBR-YRI', treatment: 'GBR', control: 'YRI' ] },
                { assert new File(workflow.out.contrastsheet_file[0].toString()).readLines() == [ 'contrast,treatment,control', 'GBR-YRI,GBR,YRI' ] }
            )
        }

    }

    test("contrastsheet - new header") {

        when {
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = "${outputDir}"
                input[5] = params.pipelines_testdata_base_path + 'samplesheet/samplesheet_bam.csv'
                input[6] = "${launchDir}/contrastsheet_new.csv"
                input[7] = false
                input[8] = false
                input[9] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.contrastsheet.size() == 1 },
                // reference is the control and target the treatment, so the contrast is GBR over YRI
                { assert workflow.out.contrastsheet[0] == [ contrast: 'GBR-YRI', treatment: 'GBR', control: 'YRI' ] },
                // The modules reading the sheet get the legacy header
                { assert new File(workflow.out.contrastsheet_file[0].toString()).readLines() == [ 'contrast,treatment,control', 'GBR-YRI,GBR,YRI' ] }
            )
        }

    }

    test("contrastsheet - blocking is passed on") {

        when {
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = "${outputDir}"
                input[5] = "${launchDir}/samplesheet_genome_bam_blocking.csv"
                input[6] = "${launchDir}/contrastsheet_new_blocking.csv"
                input[7] = false
                input[8] = false
                input[9] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // An NA blocking value means no blocking, as in nf-core/differentialabundance
                { assert workflow.out.contrastsheet == [
                    [ contrast: 'GBR-YRI', treatment: 'GBR', control: 'YRI', blocking: 'batch' ],
                    [ contrast: 'YRI-GBR', treatment: 'YRI', control: 'GBR' ]
                ] },
                // Commas and whitespace in the values are replaced
                { assert workflow.out.blocking_values == [ [
                    ERR188383: [ batch: 'b_1' ],
                    ERR188428: [ batch: 'b_2' ],
                    ERR188454: [ batch: 'b_1' ],
                    ERR204916: [ batch: 'b_2' ]
                ] ] }
            )
        }

    }

    test("contrastsheet - blocking variable with a single value is left out") {

        when {
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = "${outputDir}"
                input[5] = "${launchDir}/samplesheet_genome_bam_constant.csv"
                input[6] = "${launchDir}/contrastsheet_new_blocking.csv"
                input[7] = false
                input[8] = false
                input[9] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.contrastsheet == [
                    [ contrast: 'GBR-YRI', treatment: 'GBR', control: 'YRI' ],
                    [ contrast: 'YRI-GBR', treatment: 'YRI', control: 'GBR' ]
                ] },
                { assert (workflow.stdout + workflow.stderr).any { line -> line.contains("blocking column 'batch' has a single value") } }
            )
        }

    }

    test("contrastsheet - blocking variable confounded with the condition fails") {

        when {
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = "${outputDir}"
                input[5] = "${launchDir}/samplesheet_genome_bam_confounded.csv"
                input[6] = "${launchDir}/contrastsheet_new_blocking.csv"
                input[7] = false
                input[8] = false
                input[9] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { line -> line.contains("blocking column 'batch' is confounded with the condition") } }
            )
        }

    }

    test("contrastsheet - blocking column missing from the samplesheet fails") {

        when {
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = "${outputDir}"
                input[5] = params.pipelines_testdata_base_path + 'samplesheet/samplesheet_bam.csv'
                input[6] = "${launchDir}/contrastsheet_new_blocking.csv"
                input[7] = false
                input[8] = false
                input[9] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { line -> line.contains("Contrast 'GBR-YRI': blocking columns missing from the samplesheet: batch") } }
            )
        }

    }

    // The schema rejects these sheets, with the details in the Nextflow log
    test("contrastsheet - mixed headers fail") {

        when {
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = "${outputDir}"
                input[5] = params.pipelines_testdata_base_path + 'samplesheet/samplesheet_bam.csv'
                input[6] = "${launchDir}/contrastsheet_mixed.csv"
                input[7] = false
                input[8] = false
                input[9] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains("Validation of samplesheet failed") } }
            )
        }

    }

    test("contrastsheet - unsupported variable fails") {

        when {
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = "${outputDir}"
                input[5] = params.pipelines_testdata_base_path + 'samplesheet/samplesheet_bam.csv'
                input[6] = "${launchDir}/contrastsheet_variable.csv"
                input[7] = false
                input[8] = false
                input[9] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains("Validation of samplesheet failed") } }
            )
        }

    }

    test("contrastsheet - missing value fails") {

        when {
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = "${outputDir}"
                input[5] = params.pipelines_testdata_base_path + 'samplesheet/samplesheet_bam.csv'
                input[6] = "${launchDir}/contrastsheet_missing_target.csv"
                input[7] = false
                input[8] = false
                input[9] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains("Validation of samplesheet failed") } }
            )
        }

    }

    test("contrastsheet - duplicate id fails") {

        when {
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = "${outputDir}"
                input[5] = params.pipelines_testdata_base_path + 'samplesheet/samplesheet_bam.csv'
                input[6] = "${launchDir}/contrastsheet_dup_id.csv"
                input[7] = false
                input[8] = false
                input[9] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains("Validation of samplesheet failed") } },
                { assert (workflow.stdout + workflow.stderr).any { it.contains("Detected duplicate entries: [id:GBR-YRI]") } }
            )
        }

    }

    test("contrastsheet - duplicate legacy contrast fails") {

        when {
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = "${outputDir}"
                input[5] = params.pipelines_testdata_base_path + 'samplesheet/samplesheet_bam.csv'
                input[6] = "${launchDir}/contrastsheet_dup_legacy.csv"
                input[7] = false
                input[8] = false
                input[9] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { it.contains("Validation of samplesheet failed") } },
                { assert (workflow.stdout + workflow.stderr).any { it.contains("Detected duplicate entries: [contrast:GBR-YRI]") } }
            )
        }

    }

}
