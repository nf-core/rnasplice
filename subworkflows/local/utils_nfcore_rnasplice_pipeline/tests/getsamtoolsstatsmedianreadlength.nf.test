nextflow_function {

    name "Test Function getSamtoolsStatsMedianReadLength"
    script "../main.nf"
    function "getSamtoolsStatsMedianReadLength"

    tag "subworkflows"
    tag "subworkflows/utils_nfcore_rnasplice_pipeline"

    // Small samtools stats files, written by each test, holding only the summary line and
    // the read length histogram that the function reads
    test("one sample - trimmed reads") {

        when {
            function {
                """
                def stats = file('${outputDir}/trimmed.stats')
                stats.text = [
                    'SN\\tsequences:\\t1000',
                    'RL\\t36\\t100',
                    'RL\\t60\\t200',
                    'RL\\t75\\t700',
                ].join('\\n')
                input[0] = [ [ [ id: 'trimmed' ], stats ] ]
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == [ median: 75, samples_without_reads: [] ] }
            )
        }

    }

    test("two samples - different read lengths") {

        when {
            function {
                """
                def stats_75 = file('${outputDir}/sample_75.stats')
                stats_75.text = 'RL\\t75\\t400\\n'
                def stats_100 = file('${outputDir}/sample_100.stats')
                stats_100.text = 'RL\\t100\\t600\\n'
                input[0] = [ [ [ id: 'sample_75' ], stats_75 ], [ [ id: 'sample_100' ], stats_100 ] ]
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == [ median: 100, samples_without_reads: [] ] }
            )
        }

    }

    test("two samples - one with no reads") {

        when {
            function {
                """
                def stats_75 = file('${outputDir}/sample_75.stats')
                stats_75.text = 'SN\\tsequences:\\t400\\nRL\\t75\\t400\\n'
                def stats_empty = file('${outputDir}/sample_empty.stats')
                stats_empty.text = 'SN\\tsequences:\\t0\\n'
                input[0] = [ [ [ id: 'sample_empty' ], stats_empty ], [ [ id: 'sample_75' ], stats_75 ] ]
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == [ median: 75, samples_without_reads: [ 'sample_empty' ] ] }
            )
        }

    }

    test("stub - empty files") {

        when {
            function {
                """
                def stats_b = file('${outputDir}/sample_b.stats')
                stats_b.text = ''
                def stats_a = file('${outputDir}/sample_a.stats')
                stats_a.text = ''
                input[0] = [ [ [ id: 'sample_b' ], stats_b ], [ [ id: 'sample_a' ], stats_a ] ]
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == [ median: null, samples_without_reads: [ 'sample_a', 'sample_b' ] ] }
            )
        }

    }

}
