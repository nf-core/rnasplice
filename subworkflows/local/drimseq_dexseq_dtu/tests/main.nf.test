// nf-core subworkflows test drimseq_dexseq_dtu
nextflow_workflow {

    name "Test Subworkflow DRIMSEQ_DEXSEQ_DTU"
    script "../main.nf"
    workflow "DRIMSEQ_DEXSEQ_DTU"

    tag "subworkflows"
    tag "subworkflows/drimseq_dexseq_dtu"
    tag "drimseq"
    tag "drimseq/dmfilter"
    tag "dexseq"
    tag "dexseq/dtu"
    tag "stager"

    // The gene annotation comes from the whole chrX GTF the transcript counts were made with,
    // not the chrX_subset one of the other tests
    setup {
        run("GFFREAD", alias: "GFFREAD_TX2GENE") {
            script '../../../../modules/nf-core/gffread/main.nf'
            process {
            """
            input[0] = [ [ id:'genes' ], file('https://raw.githubusercontent.com/nf-core/test-datasets/rnasplice/reference/genes_chrX.gtf', checkIfExists: true) ]
            input[1] = []
            """
            }
        }

        run("GENEANNOTATION_TABLES") {
            script '../../../../modules/local/geneannotation/tables/main.nf'
            process {
            """
            input[0] = GFFREAD_TX2GENE.out.table.map { _meta, table -> [ [ id:'genes_chrX' ], table ] }
            """
            }
        }
    }

    test("human chrX - tximport transcript counts") {

        when {
            workflow {
                """
                input[0] = channel.value(file(params.modules_testdata_base_path + 'genomics/homo_sapiens/rnaseq_expression/chrX.transcript_counts.tsv', checkIfExists: true))
                input[1] = channel.value(file(params.modules_testdata_base_path + 'genomics/homo_sapiens/rnaseq_expression/chrX.samplesheet.csv', checkIfExists: true))
                input[2] = channel.of(
                    [ contrast:'GBR-YRI', treatment:'GBR', control:'YRI' ],
                    [ contrast:'YRI-GBR', treatment:'YRI', control:'GBR' ],
                )
                input[3] = GENEANNOTATION_TABLES.out.gene.first()
                """
            }
        }

        then {
            // `DEXSEQ_DTU` and `STAGER` run once per contrast, so their channels follow task
            // completion order and have to be sorted before they can be snapshotted.
            //
            // The DRIMSeq tables are filtered input, so their content is snapshotted, but
            // everything downstream of DEXSeq is not reproducible across machines, which
            // is why tests/.nftignore already excludes those tables from the pipeline
            // level snapshots. They are snapshotted by shape instead: file name, header
            // and row count. Every gene of the annotated copies has a name in the test annotation
            assertAll(
                { assert workflow.success },
                { assert workflow.out.dexseq_annotated_tsv.every { _meta, table -> path(table).readLines().drop(1).every { line -> line.split('\t')[1] != 'NA' } } },
                { assert workflow.out.stager_padj_annotated_tsv.every { _meta, table -> path(table).readLines().drop(1).every { line -> line.split('\t')[1] != 'NA' } } },
                { assert snapshot(
                    workflow.out.drimseq_samples_tsv,
                    workflow.out.drimseq_counts_tsv,
                    workflow.out.drimseq_dataset_rds.flatten().collect { rds -> file(rds).name },
                    workflow.out.dexseq_exon_dataset_rds.collect { meta, rds -> [ meta, file(rds).name ] }.sort { rds -> rds[0].id },
                    workflow.out.dexseq_exon_results_rds.collect { meta, rds -> [ meta, file(rds).name ] }.sort { rds -> rds[0].id },
                    workflow.out.dexseq_gene_results_rds.collect { meta, rds -> [ meta, file(rds).name ] }.sort { rds -> rds[0].id },
                    workflow.out.dexseq_exon_results_tsv.collect { meta, tsv ->
                        def lines = path(tsv).readLines()
                        [ meta, file(tsv).name, lines[0], lines.size() ]
                    }.sort { tsv -> tsv[0].id },
                    workflow.out.dexseq_gene_results_tsv.collect { meta, tsv ->
                        def lines = path(tsv).readLines()
                        [ meta, file(tsv).name, lines[0], lines.size() ]
                    }.sort { tsv -> tsv[0].id },
                    workflow.out.stager_rds.collect { meta, rds -> [ meta, file(rds).name ] }.sort { rds -> rds[0].id },
                    workflow.out.stager_padj_rds.collect { meta, rds -> [ meta, file(rds).name ] }.sort { rds -> rds[0].id },
                    workflow.out.stager_padj_tsv.collect { meta, tsv ->
                        def lines = path(tsv).readLines()
                        [ meta, file(tsv).name, lines[0], lines.size() ]
                    }.sort { padj -> padj[0].id },
                    workflow.out.dexseq_annotated_tsv.collect { meta, table -> [ meta, file(table).name, path(table).readLines()[0], path(table).readLines().size() ] }.sort { tsv -> tsv[1] },
                    workflow.out.stager_padj_annotated_tsv.collect { meta, table -> [ meta, file(table).name, path(table).readLines()[0], path(table).readLines().size() ] }.sort { tsv -> tsv[1] }
                ).match() }
            )
        }

    }

    test("human chrX - tximport transcript counts - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.value(file(params.modules_testdata_base_path + 'genomics/homo_sapiens/rnaseq_expression/chrX.transcript_counts.tsv', checkIfExists: true))
                input[1] = channel.value(file(params.modules_testdata_base_path + 'genomics/homo_sapiens/rnaseq_expression/chrX.samplesheet.csv', checkIfExists: true))
                input[2] = channel.of(
                    [ contrast:'GBR-YRI', treatment:'GBR', control:'YRI' ],
                    [ contrast:'YRI-GBR', treatment:'YRI', control:'GBR' ],
                )
                input[3] = GENEANNOTATION_TABLES.out.gene.first()
                """
            }
        }

        then {
            // `DEXSEQ_DTU` and `STAGER` run once per contrast, so their channels follow task
            // completion order and have to be sorted before they can be snapshotted
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.drimseq_dataset_rds,
                    workflow.out.drimseq_samples_tsv,
                    workflow.out.drimseq_counts_tsv,
                    workflow.out.dexseq_exon_dataset_rds.sort { rds -> rds[0].id },
                    workflow.out.dexseq_exon_results_rds.sort { rds -> rds[0].id },
                    workflow.out.dexseq_exon_results_tsv.sort { tsv -> tsv[0].id },
                    workflow.out.dexseq_gene_results_rds.sort { rds -> rds[0].id },
                    workflow.out.dexseq_gene_results_tsv.sort { tsv -> tsv[0].id },
                    workflow.out.stager_rds.sort { rds -> rds[0].id },
                    workflow.out.stager_padj_rds.sort { rds -> rds[0].id },
                    workflow.out.stager_padj_tsv.sort { tsv -> tsv[0].id },
                    workflow.out.dexseq_annotated_tsv.sort { tsv -> file(tsv[1]).name },
                    workflow.out.stager_padj_annotated_tsv.sort { tsv -> tsv[0].id }
                ).match() }
            )
        }

    }

}
