// nf-core subworkflows test edger_deu
nextflow_workflow {

    name "Test Subworkflow EDGER_DEU"
    script "../main.nf"
    workflow "EDGER_DEU"

    tag "subworkflows"
    tag "subworkflows/edger_deu"
    tag "subread"
    tag "subread/flattengtf"
    tag "subread/featurecounts"
    tag "csvtk"
    tag "csvtk/join"
    tag "edger"
    tag "edger/diffsplice"

    // The gene annotation table the annotated copies of the results tables are made from
    setup {
        run("GFFREAD_TX2GENE") {
            script '../../../../modules/local/gffread/tx2gene/main.nf'
            process {
            """
            input[0] = file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true)
            """
            }
        }

        run("GENEANNOTATION_TABLES") {
            script '../../../../modules/local/geneannotation/tables/main.nf'
            process {
            """
            input[0] = GFFREAD_TX2GENE.out.tx2gene.map { tx2gene -> [ [ id:'genes_chrX' ], tx2gene ] }
            """
            }
        }
    }

    test("human chrX") {

        when {
            workflow {
                """
                input[0] = channel.value(file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true))
                input[1] = channel.of(
                    [ [ id:'ERR188383', condition:'GBR', single_end:false, strandedness:'unstranded' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam', checkIfExists: true) ],
                    [ [ id:'ERR188428', condition:'GBR', single_end:false, strandedness:'unstranded' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188428.Aligned.out.bam', checkIfExists: true) ],
                    [ [ id:'ERR188454', condition:'YRI', single_end:false, strandedness:'unstranded' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188454.Aligned.out.bam', checkIfExists: true) ],
                    [ [ id:'ERR204916', condition:'YRI', single_end:false, strandedness:'unstranded' ], file(params.pipelines_testdata_base_path + 'testdata/ERR204916.Aligned.out.bam', checkIfExists: true) ],
                )
                input[2] = channel.of([ contrast:'GBR-YRI', treatment:'GBR', control:'YRI' ])
                input[3] = GENEANNOTATION_TABLES.out.gene.first()
                """
            }
        }

        then {
            // `SUBREAD_FEATURECOUNTS` runs once per sample, so its channels follow task
            // completion order and have to be sorted before they can be snapshotted.
            //
            // The joined count table is deterministic, so its content is snapshotted. The
            // edgeR result tables differ in the last digits between builds of edgeR, so they
            // are snapshotted by name, header and row count, and the plots and binary objects
            // by name. Every gene of the annotated copies has a name in the test annotation
            assertAll(
                { assert workflow.success },
                { assert workflow.out.annotated.every { _meta, table -> path(table).readLines().drop(1).every { line -> line.split('\t')[1] != 'NA' } } },
                { assert snapshot(
                    workflow.out.featureCounts_summary.sort { summary -> summary[0].id },
                    workflow.out.featureCounts_counts.collect { meta, counts -> [ meta, file(counts).name ] }.sort { counts -> counts[0].id },
                    workflow.out.counts,
                    [ workflow.out.results, workflow.out.simes, workflow.out.gene ].collect { tables ->
                        tables.collect { meta, table -> [ meta, file(table).name, path(table).readLines()[0], path(table).readLines().size() ] }
                    },
                    [ workflow.out.plots, workflow.out.bcv_plot, workflow.out.rdata, workflow.out.lrt ].collect { files ->
                        files.collect { meta, f -> [ meta, file(f).name ] }
                    },
                    workflow.out.annotated.collect { meta, table -> [ meta, file(table).name, path(table).readLines()[0], path(table).readLines().size() ] }.sort { table -> table[1] }
                ).match() }
            )
        }

    }

    test("human chrX - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.value(file(params.pipelines_testdata_base_path + 'reference/genes_chrX.gtf', checkIfExists: true))
                input[1] = channel.of(
                    [ [ id:'ERR188383', condition:'GBR', single_end:false, strandedness:'unstranded' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188383.Aligned.out.bam', checkIfExists: true) ],
                    [ [ id:'ERR188428', condition:'GBR', single_end:false, strandedness:'unstranded' ], file(params.pipelines_testdata_base_path + 'testdata/ERR188428.Aligned.out.bam', checkIfExists: true) ],
                )
                input[2] = channel.of([ contrast:'GBR-YRI', treatment:'GBR', control:'YRI' ])
                input[3] = GENEANNOTATION_TABLES.out.gene.first()
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.featureCounts_counts.sort { counts -> counts[0].id },
                    workflow.out.featureCounts_summary.sort { summary -> summary[0].id },
                    workflow.out.counts,
                    workflow.out.results,
                    workflow.out.simes,
                    workflow.out.gene,
                    workflow.out.plots,
                    workflow.out.bcv_plot,
                    workflow.out.rdata,
                    workflow.out.lrt,
                    workflow.out.annotated.sort { table -> file(table[1]).name }
                ).match() }
            )
        }

    }

}
