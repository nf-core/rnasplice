/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// Specify any additional parameters here
// Or any resources requirements
params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/rnasplice/chrX_subset/'

    // Module and subworkflow tests run without main.nf, which declares these and sets the
    // output directory of a pipeline run
    outdir       = 'results'
    gff          = null
    salmon_index = null
}

validation {
    ignoreParams = ['modules_testdata_base_path']
}

// Fixes S3 access issues on self-hosted runners
aws.client.anonymous = true
