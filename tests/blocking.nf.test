nextflow_pipeline {

    name "Test pipeline with a blocking variable"
    script "../main.nf"
    profile "test_blocking"
    tag "pipeline"

    test("-profile test_blocking") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])

            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')

            // Sorted BAM files: left out of stable_content by the ignoreFile, as the conda and
            // container builds of samtools write different BAM headers, and snapshotted by the
            // md5 of their alignments instead
            def sorted_bams = getAllFilesFromDir(params.outdir, include: ['*_sorted.bam', '**/*_sorted.bam'])
                .collectEntries { bam_file -> [ bam_file.name, bam(bam_file.toString()).getSamLinesMD5() ] }

            // Models the DEXSeq exon and DTU tasks fitted, by contrast. The DEXSeq results vary
            // with the CPU and are left out of stable_content, so the models are read from the
            // task logs. Only successful tasks write a results table, so retries are skipped
            def dexseq_models = [:].withDefault { [] }
            new File("${launchDir}/work").eachFileRecurse { log_file ->
                if (log_file.name == '.command.err') {
                    def model = (log_file.text =~ /Full model: (.+)/).findResult { match -> match[1].trim() }
                    def results = log_file.parentFile.listFiles().find { file -> file.name.endsWith('.dexseq.results.tsv') }
                    if (model && results) {
                        dexseq_models[results.name - '.dexseq.results.tsv'] << model
                    }
                }
            }

            // Models edgeR fitted, by contrast, from the model files it publishes
            def edger_models = getAllFilesFromDir(params.outdir, include: ['**/*.edger.model.txt'])
                .collectEntries { model_file -> [ model_file.name - '.edger.model.txt', model_file.text.trim() ] }

            // Columns of the LeafCutter groups file of each contrast, from the files the
            // clustering step collects in the work directory
            def leafcutter_groups = [:]
            new File("${launchDir}/work").eachFileRecurse { groups_file ->
                if (groups_file.name.endsWith('_groups.txt')) {
                    leafcutter_groups[groups_file.name - '_groups.txt'] = groups_file.readLines().collect { line -> line.split('\t') as List }
                }
            }

            // rMATS tests GBR-YRI with the paired model, as batch pairs its samples, and
            // YRI-GBR, which has no blocking, with the unpaired one
            def rmats_logs = getAllFilesFromDir(params.outdir, include: ['**/rmats/*.log']).collect { log_file -> log_file.name }.sort()

            assert workflow.success

            assertAll(
                // GBR-YRI is blocked on batch and YRI-GBR is not, in the DEXSeq exon analysis and in
                // the DTU analyses of the STAR and Salmon quantifications
                { assert dexseq_models == [
                    'GBR-YRI': ['~sample + exon + batch:exon + condition:exon'] * 3,
                    'YRI-GBR': ['~sample + exon + condition:exon'] * 3
                ] },
                { assert edger_models == [
                    'GBR-YRI': '~ 0 + condition+batch',
                    'YRI-GBR': '~ 0 + condition'
                ] },
                { assert leafcutter_groups['GBR-YRI'].every { columns -> columns.size() == 3 && columns[2] =~ /^batch_\d+$/ } },
                { assert leafcutter_groups['YRI-GBR'].every { columns -> columns.size() == 2 } },
                { assert rmats_logs == [ 'GBR-YRI_paired.log', 'YRI-GBR.log' ] },
                { assert snapshot(
                    // Remove Nextflow version to prevent cross-version testing failures
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_rnasplice_software_mqc_versions.yml"),

                    // Snapshot the clean directory structure
                    stable_path,

                    // Snapshot the deterministic data file contents
                    stable_content,

                    // Snapshot the sorted BAM files by the md5 of their alignments
                    sorted_bams
                ).match() }
            )
        }

        cleanup {
            // Only prune/delete on CI - keeping local VM state intact prevents
            // cross-test launchDir wipes that break nf-test snapshot walks.
            if (System.getenv("CI") == "true") {
                if (System.getenv("NFT_PROFILE")?.contains("docker")) {
                    "docker system prune -a -f --volumes".execute()
                }
                new File("${launchDir}").deleteDir()
            }
        }
    }
}
