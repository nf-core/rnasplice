nextflow_workflow {

    name "Test STAR read groups with --seq_center"
    script "../subworkflows/nf-core/fastq_align_star/main.nf"
    workflow "FASTQ_ALIGN_STAR"
    config "./seq_center.config"

    tag "pipeline"
    tag "star"
    tag "star/align"

    // The read group line is set in conf/modules.config, so it is checked through the
    // pipeline configuration rather than in the subworkflow's own tests
    test("homo_sapiens - paired_end - seq_center") {

        setup {
            run("STAR_GENOMEGENERATE") {
                script "../modules/nf-core/star/genomegenerate/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [ id:'test_fasta' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                    ])
                    input[1] = channel.of([
                        [ id:'test_gtf' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true)
                    ])
                    """
                }
            }
        }

        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test', single_end:false ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[1] = STAR_GENOMEGENERATE.out.index
                input[2] = channel.of([
                    [ id:'test_gtf' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true)
                ])
                input[3] = false
                input[4] = channel.of([
                    [ id:'test_fasta' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true)
                ])
                input[5] = [ [:], [], [] ]
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path(workflow.out.log_out[0][1]).text.contains("--outSAMattrRGline ID:test SM:test CN:sequencing_center") }
            )
        }
    }
}
