nextflow_pipeline {

    name "Test pipeline with a user supplied DEXSeq annotation"
    script "../main.nf"
    profile "test_dexseq_gff"
    tag "pipeline"

    test("-profile test_dexseq_gff") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])

            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')

            // The annotation is supplied gzipped, so it has to be uncompressed by
            // PREPARE_GENOME and used as is, rather than re-flattened from the GTF
            def task_names = workflow.trace.tasks().collect { task -> task.name }

            assert workflow.success

            assertAll(
                { assert task_names.any { name -> name.contains('GUNZIP_GFF_DEXSEQ') } },
                { assert !task_names.any { name -> name.contains('DEXSEQ_ANNOTATION') } },
                { assert task_names.count { name -> name.contains('DEXSEQ_COUNT') } == 4 },
                { assert snapshot(
                    // Remove Nextflow version to prevent cross-version testing failures
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_rnasplice_software_mqc_versions.yml"),

                    // Snapshot the clean directory structure
                    stable_path,

                    // Snapshot the deterministic data file contents
                    stable_content
                ).match() }
            )
        }

        cleanup {
            // Only prune/delete on CI - keeping local VM state intact prevents
            // cross-test launchDir wipes that break nf-test snapshot walks.
            if (System.getenv("CI") == "true") {
                if (System.getenv("NFT_PROFILE")?.contains("docker")) {
                    "docker system prune -a -f --volumes".execute()
                }
                new File("${launchDir}").deleteDir()
            }
        }
    }
}
