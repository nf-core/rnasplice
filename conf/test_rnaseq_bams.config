/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Runs the pipeline on the samplesheet_with_bams.csv of an nf-core/rnaseq run, with a
    condition column added, and the transcript FASTA that run aligned to.

    Use as follows:
        nextflow run nf-core/rnasplice -profile test_rnaseq_bams,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {

    // Config information
    config_profile_name        = 'nf-core/rnaseq hand-off test profile'
    config_profile_description = 'Minimal test dataset to check the hand-off from nf-core/rnaseq'

    // Input data
    input     = 'https://raw.githubusercontent.com/nf-core/test-datasets/rnasplice/chrX_subset/samplesheet/samplesheet_with_bams.csv'
    contrasts = 'https://raw.githubusercontent.com/nf-core/test-datasets/rnasplice/chrX_subset/samplesheet/contrastsheet.csv'

    // Genome references
    fasta            = 'https://raw.githubusercontent.com/nf-core/test-datasets/rnasplice/chrX_subset/reference/X.fa.gz'
    gtf              = 'https://raw.githubusercontent.com/nf-core/test-datasets/rnasplice/chrX_subset/reference/genes_chrX.gtf'
    transcript_fasta = 'https://raw.githubusercontent.com/nf-core/test-datasets/rnasplice/chrX_subset/testdata/rnaseq/genome.transcripts.fa'

    // Run paired rMATS statistical model
    rmats_paired_stats = true

}
// Limit resources so that this can run on GitHub Actions
process {
  resourceLimits = [
    cpus: 2,
    memory: 6.GB,
    time: 6.h
  ]
}
