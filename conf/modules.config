/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    // Global default fallback publishing directory layout
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // ====================================================================
    // CORE QUALITY CONTROL & INFRASTRUCTURE
    // ====================================================================

    withName: CUSTOM_DUMPSOFTWAREVERSIONS {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            pattern: '*_versions.yml'
        ]
    }

    withName: 'FASTQC' {
        ext.args   = '--quiet'
        publishDir = [
            path: { "${params.outdir}/fastqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!(!params.skip_fastqc && params.source == 'fastq')) return null
                return filename
            }
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*:FASTQ_FASTQC_UMITOOLS_TRIMGALORE:TRIMGALORE' {
        ext.args   = { [
            params.skip_trimgalore_fastqc ? "" : '--fastqc',
            params.trim_nextseq > 0 ? "--nextseq ${params.trim_nextseq}" : '',
            params.clip_r1 ? "--clip_R1 ${params.clip_r1}" : '',
            params.clip_r2 ? "--clip_R2 ${params.clip_r2}" : '',
        ].join(' ').trim() }
        publishDir = [
            [
                path: { "${params.outdir}/trimgalore/fastqc" },
                mode: params.publish_dir_mode,
                pattern: "*.{html,zip}",
                saveAs: { filename -> (params.source == 'fastq' && !params.skip_trimming) ? filename : null }
            ],
            [
                path: { "${params.outdir}/trimgalore" },
                mode: params.publish_dir_mode,
                pattern: "*.fq.gz",
                saveAs: { filename -> (params.source == 'fastq' && !params.skip_trimming && params.save_trimmed) ? filename : null }
            ],
            [
                path: { "${params.outdir}/trimgalore" },
                mode: params.publish_dir_mode,
                pattern: "*.txt",
                saveAs: { filename -> (params.source == 'fastq' && !params.skip_trimming) ? filename : null }
            ]
        ]
    }

    // ====================================================================
    // GENOME INDEXING & REFERENCE PREPARATION
    // ====================================================================

    withName: 'GUNZIP_.*|MAKE_TRANSCRIPTS_FASTA' {
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!params.save_reference) return null
                return filename
            }
        ]
    }

    withName: 'UNTAR_.*' {
        ext.args2 = '--no-same-owner'
    }

    withName: 'UNTAR_.*|STAR_GENOMEGENERATE|STAR_GENOMEGENERATE_IGENOMES' {
        publishDir = [
            path: { "${params.outdir}/genome/index" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!params.save_reference) return null
                return filename
            }
        ]
    }

    withName: 'GFFREAD' {
        ext.args   = '--keep-exon-attrs -F -T'
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!params.save_reference) return null
                return filename
            }
        ]
    }

    withName: 'GFFREAD_TX2GENE' {
        ext.args   = { "--table transcript_id,${params.gtf_group_features},${params.gtf_extra_attributes}" }
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!params.save_reference) return null
                return filename
            }
        ]
    }

    withName: 'SALMON_INDEX' {
        ext.args   = { params.gencode ? '--gencode' : '' }
        publishDir = [
            path: { "${params.outdir}/genome/index" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!params.save_reference) return null
                return filename
            }
        ]
    }

    withName: 'CAT_FASTQ' {
        publishDir = [
            path: { "${params.outdir}/fastq" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!params.save_merged_fastq) return null
                return filename
            }
        ]
    }

    withName: 'SAMTOOLS_FAIDX' {
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!params.save_reference) return null
                return filename
            }
        ]
    }

    withName: 'PREPROCESS_TRANSCRIPTS_FASTA_GENCODE' {
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!params.save_reference) return null
                return filename
            }
        ]
    }

    withName: 'GTFGENEFILTER' {
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!params.save_reference) return null
                return filename
            }
        ]
    }

    // ====================================================================
    // ALIGNMENT & QUANTIFICATION MODULES
    // ====================================================================

    withName: 'STAR_ALIGN|STAR_ALIGN_IGENOMES' {
        ext.args   = { [
            '--quantMode TranscriptomeSAM',
            '--twopassMode Basic',
            '--outSAMtype BAM Unsorted',
            '--readFilesCommand gunzip -c',
            '--runRNGseed 0',
            '--outFilterMultimapNmax 20',
            '--alignSJDBoverhangMin 1',
            '--outSAMattributes NH HI AS NM MD',
            '--quantTranscriptomeSAMoutput BanSingleEnd',
            params.save_unaligned ? '--outReadsUnmapped Fastx' : ''
        ].join(' ').trim() }
        publishDir = [
            [
                path: { "${params.outdir}/${params.aligner}/log" },
                mode: params.publish_dir_mode,
                pattern: '*.{out,tab}',
                saveAs: { filename -> (params.source == 'fastq' && !params.skip_alignment && ['star_salmon','star'].contains(params.aligner)) ? filename : null }
            ],
            [
                path: { "${params.outdir}/${params.aligner}" },
                mode: params.publish_dir_mode,
                pattern: '*.bam',
                saveAs: { filename -> (params.source == 'fastq' && !params.skip_alignment && ['star_salmon','star'].contains(params.aligner) && params.save_align_intermeds) ? filename : null }
            ],
            [
                path: { "${params.outdir}/${params.aligner}/unmapped" },
                mode: params.publish_dir_mode,
                pattern: '*.fastq.gz',
                saveAs: { filename -> (params.source == 'fastq' && !params.skip_alignment && ['star_salmon','star'].contains(params.aligner) && params.save_unaligned) ? filename : null }
            ]
        ]
    }

    withName: '.*:BAM_STATS_SAMTOOLS:SAMTOOLS_.*' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/samtools_stats" },
            mode: params.publish_dir_mode,
            pattern: "*.{stats,flagstat,idxstats}",
            saveAs: { filename -> (params.source != 'salmon_results' && !params.skip_alignment) ? filename : null }
        ]
    }

    withName: 'SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}_sorted" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}" },
            mode: params.publish_dir_mode,
            pattern: "*.bam",
            saveAs: { filename -> (params.source != 'salmon_results' && !params.skip_alignment && ['star_salmon','star'].contains(params.aligner)) ? filename : null }
        ]
    }

    withName: 'SAMTOOLS_INDEX' {
        ext.args   = { params.bam_csi_index ? '-c' : '' }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}" },
            mode: params.publish_dir_mode,
            pattern: "*.{bai,csi}",
            saveAs: { filename -> (params.source != 'salmon_results' && !params.skip_alignment && ['star_salmon','star'].contains(params.aligner)) ? filename : null }
        ]
    }

    withName: 'SALMON_QUANT_STAR' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/salmon" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!(['fastq', 'transcriptome_bam'].contains(params.source) && !params.skip_alignment && params.aligner == 'star_salmon')) return null
                return filename
            },
        ]
    }

    withName: 'SALMON_QUANT_SALMON' {
        publishDir = [
            path: { "${params.outdir}/${params.pseudo_aligner}" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!(params.source == 'fastq' && params.pseudo_aligner == 'salmon')) return null
                return filename
            }
        ]
    }

    // ====================================================================
    // COVERAGE TRACK GENERATION
    // ====================================================================

    withName: 'BEDTOOLS_GENOMECOV' {
        ext.args   = '-split -du -bg'
        publishDir = [
            path: { "${params.outdir}/bedtools/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> null }
        ]
    }

    withName: 'BEDTOOLS_GENOMECOV_FORWARD' {
        ext.args   = '-split -du -bg -strand +'
        publishDir = [
            path: { "${params.outdir}/bedtools/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> null }
        ]
    }

    withName: 'BEDTOOLS_GENOMECOV_REVERSE' {
        ext.args   = '-split -du -bg -strand -'
        publishDir = [
            path: { "${params.outdir}/bedtools/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> null }
        ]
    }

    withName: '.*:BEDGRAPH_TO_BIGWIG_FORWARD:UCSC_BEDCLIP' {
        ext.prefix = { "${meta.id}.clip.forward" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> null }
        ]
    }

    withName: '.*:BEDGRAPH_TO_BIGWIG_FORWARD:UCSC_BEDGRAPHTOBIGWIG' {
        ext.prefix = { "${meta.id}.forward" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/bigwig" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!(['fastq', 'genome_bam'].contains(params.source) && !params.skip_alignment && !params.skip_bigwig)) return null
                return filename
            }
        ]
    }

    withName: '.*:BEDGRAPH_TO_BIGWIG_REVERSE:UCSC_BEDCLIP' {
        ext.prefix = { "${meta.id}.clip.reverse" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> null }
        ]
    }

    withName: '.*:BEDGRAPH_TO_BIGWIG_REVERSE:UCSC_BEDGRAPHTOBIGWIG' {
        ext.prefix = { "${meta.id}.reverse" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/bigwig" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!(['fastq', 'genome_bam'].contains(params.source) && !params.skip_alignment && !params.skip_bigwig)) return null
                return filename
            }
        ]
    }

    // ====================================================================
    // SPLICING ENGINES & DOWNSTREAM COHORTS
    // ====================================================================

    // --- rMATS ---
    withName: 'RMATS_PREP|RMATS_POST' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/rmats" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!(['fastq', 'genome_bam'].contains(params.source) && params.rmats)) return null
                return filename
            }
        ]
    }

    withName: 'CREATE_BAMLIST|CREATE_BAMLIST_SINGLE' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/rmats/bamlist" },
            mode: params.publish_dir_mode,
            pattern: "*.txt",
            saveAs: { filename -> (['fastq', 'genome_bam'].contains(params.source) && params.rmats) ? filename : null }
        ]
    }

    // --- Leafcutter ---
    withName: 'REGTOOLS_JUNCTIONSEXTRACT' {
        ext.args   = '-a 8 -i 50 -I 500000'
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/leafcutter" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> (['fastq', 'genome_bam'].contains(params.source) && params.leafcutter) ? filename : null }
        ]
    }

    withName: 'LEAFCUTTER_CLUSTERREGTOOLS' {
        ext.args   = '-l 500000 -m 10'
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/leafcutter" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> (['fastq', 'genome_bam'].contains(params.source) && params.leafcutter) ? filename : null }
        ]
    }

    // --- DEXSeq Exon ---
    withName: 'DEXSEQ_ANNOTATION' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/dexseq_exon/annotation" },
            mode: params.publish_dir_mode,
            pattern: "*.gff",
            saveAs: { filename -> (['fastq', 'genome_bam'].contains(params.source) && params.dexseq_exon && params.save_dexseq_annotation) ? filename : null }
        ]
    }

    withName: 'DEXSEQ_COUNT' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/dexseq_exon/counts" },
            mode: params.publish_dir_mode,
            pattern: "*.clean.count.txt",
            saveAs: { filename -> (['fastq', 'genome_bam'].contains(params.source) && params.dexseq_exon) ? filename : null }
        ]
    }

    withName: 'DEXSEQ_EXON' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/dexseq_exon/results" },
            mode: params.publish_dir_mode,
            pattern: "*.{csv,pdf,rds}",
            saveAs: { filename -> (['fastq', 'genome_bam'].contains(params.source) && params.dexseq_exon) ? filename : null }
        ]
    }

    // --- DEXSeq DTU (STAR/Salmon Paths) ---
    withName: '.*:DRIMSEQ_DEXSEQ_DTU_STAR_SALMON:DRIMSEQ_DMFILTER' {
        ext.args   = { [
            "--min_samps_gene_expr ${params.min_samps_gene_expr}",
            "--min_samps_feature_expr ${params.min_samps_feature_expr}",
            "--min_samps_feature_prop ${params.min_samps_feature_prop}",
            "--min_feature_expr ${params.min_feature_expr}",
            "--min_feature_prop ${params.min_feature_prop}",
            "--min_gene_expr ${params.min_gene_expr}"
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/dexseq_dtu/filter/drimseq" },
            mode: params.publish_dir_mode,
            pattern: "*.rds",
            saveAs: { filename -> (['fastq', 'transcriptome_bam'].contains(params.source) && params.aligner == "star_salmon" && params.dexseq_dtu) ? filename : null }
        ]
    }

    withName: '.*:DRIMSEQ_DEXSEQ_DTU_STAR_SALMON:DEXSEQ_DTU' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/dexseq_dtu/results/dexseq" },
            mode: params.publish_dir_mode,
            pattern: "*.{tsv,rds}",
            saveAs: { filename -> (['fastq', 'transcriptome_bam'].contains(params.source) && params.aligner == "star_salmon" && params.dexseq_dtu) ? filename : null }
        ]
    }

    withName: '.*:DRIMSEQ_DEXSEQ_DTU_STAR_SALMON:STAGER' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/dexseq_dtu/results/stager" },
            mode: params.publish_dir_mode,
            pattern: "*.{tsv,rds}",
            saveAs: { filename -> (['fastq', 'transcriptome_bam'].contains(params.source) && params.aligner == "star_salmon" && params.dexseq_dtu) ? filename : null }
        ]
    }

    // --- DEXSeq DTU (Pure Salmon Paths) ---
    withName: '.*:DRIMSEQ_DEXSEQ_DTU_SALMON:DRIMSEQ_DMFILTER' {
        ext.args   = { [
            "--min_samps_gene_expr ${params.min_samps_gene_expr}",
            "--min_samps_feature_expr ${params.min_samps_feature_expr}",
            "--min_samps_feature_prop ${params.min_samps_feature_prop}",
            "--min_feature_expr ${params.min_feature_expr}",
            "--min_feature_prop ${params.min_feature_prop}",
            "--min_gene_expr ${params.min_gene_expr}"
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/${params.pseudo_aligner}/dexseq_dtu/filter/drimseq" },
            mode: params.publish_dir_mode,
            pattern: "*.rds",
            saveAs: { filename -> (['fastq', 'salmon_results'].contains(params.source) && params.pseudo_aligner == "salmon" && params.dexseq_dtu) ? filename : null }
        ]
    }

    withName: '.*:DRIMSEQ_DEXSEQ_DTU_SALMON:DEXSEQ_DTU' {
        publishDir = [
            path: { "${params.outdir}/${params.pseudo_aligner}/dexseq_dtu/results/dexseq" },
            mode: params.publish_dir_mode,
            pattern: "*.{tsv,rds}",
            saveAs: { filename -> (['fastq', 'salmon_results'].contains(params.source) && params.pseudo_aligner == "salmon" && params.dexseq_dtu) ? filename : null }
        ]
    }

    withName: '.*:DRIMSEQ_DEXSEQ_DTU_SALMON:STAGER' {
        publishDir = [
            path: { "${params.outdir}/${params.pseudo_aligner}/dexseq_dtu/results/stager" },
            mode: params.publish_dir_mode,
            pattern: "*.{tsv,rds}",
            saveAs: { filename -> (['fastq', 'salmon_results'].contains(params.source) && params.pseudo_aligner == "salmon" && params.dexseq_dtu) ? filename : null }
        ]
    }

    // --- edgeR DEU ---
    withName: 'SUBREAD_FLATTENGTF' {
        ext.args   = { [ "-t exon", "-g ${params.gtf_group_features}", '-C' ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/featurecounts" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!(['fastq', 'genome_bam'].contains(params.source) && params.edger_exon)) return null
                return filename
            }
        ]
    }

    withName: 'SUBREAD_FEATURECOUNTS' {
        ext.args   = { [ '-F SAF', "-t exon", "-g ${params.gtf_group_features}", '-f', '-O', '-B', '-C' ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/featurecounts" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!(['fastq', 'genome_bam'].contains(params.source) && params.edger_exon)) return null
                return filename
            }
        ]
    }

    withName: 'EDGER_EXON' {
        ext.args   = { "--n_edger_plot ${params.n_edger_plot}" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/edger" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!(['fastq', 'genome_bam'].contains(params.source) && params.edger_exon)) return null
                return filename
            }
        ]
    }

    // --- SUPPA (STAR/Salmon Path) ---
    withName: '.*:SUPPA_STAR_SALMON:SUPPA_GENERATEEVENTS_(IOE|IOI)' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.aligner}/suppa/generate_events/per_local_event" },
                mode: params.publish_dir_mode,
                pattern: '*.{ioe,gtf}',
                saveAs: { filename -> (['fastq', 'transcriptome_bam'].contains(params.source) && params.aligner == "star_salmon" && params.suppa && params.suppa_per_local_event) ? filename : null }
            ],
            [
                path: { "${params.outdir}/${params.aligner}/suppa/generate_events/per_isoform" },
                mode: params.publish_dir_mode,
                pattern: '*.ioi',
                saveAs: { filename -> (['fastq', 'transcriptome_bam'].contains(params.source) && params.aligner == "star_salmon" && params.suppa && params.suppa_per_isoform) ? filename : null }
            ]
        ]
    }

    withName: '.*:SUPPA_STAR_SALMON:SUPPA_MERGEEVENTS' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.aligner}/suppa/generate_events/per_local_event/merged_events" },
                mode: params.publish_dir_mode,
                pattern: '*.{ioe,gtf}',
                saveAs: { filename -> (['fastq', 'transcriptome_bam'].contains(params.source) && params.aligner == "star_salmon" && params.suppa && params.suppa_per_local_event) ? filename : null }
            ],
            [
                path: { "${params.outdir}/${params.aligner}/suppa/generate_events/per_isoform/merged_events" },
                mode: params.publish_dir_mode,
                pattern: '*.ioi',
                saveAs: { filename -> (['fastq', 'transcriptome_bam'].contains(params.source) && params.aligner == "star_salmon" && params.suppa && params.suppa_per_isoform) ? filename : null }
            ]
        ]
    }

    withName: '.*:SUPPA_STAR_SALMON:SUPPA_PSIPEREVENT' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/suppa/psi_per_local_event" },
            mode: params.publish_dir_mode,
            pattern: '*.psi',
            saveAs: { filename -> (['fastq', 'transcriptome_bam'].contains(params.source) && params.aligner == "star_salmon" && params.suppa && params.suppa_per_local_event) ? filename : null }
        ]
    }

    withName: '.*:SUPPA_STAR_SALMON:SUPPA_PSIPERISOFORM' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/suppa/psi_per_isoform" },
            mode: params.publish_dir_mode,
            pattern: '*.psi',
            saveAs: { filename -> (['fastq', 'transcriptome_bam'].contains(params.source) && params.aligner == "star_salmon" && params.suppa && params.suppa_per_isoform) ? filename : null }
        ]
    }

    withName: '.*:SUPPA_STAR_SALMON:SPLIT_FILES_(TPM|IOE|IOI)' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.aligner}/suppa/split_files/per_local_event" },
                mode: params.publish_dir_mode,
                pattern: 'local*.{tpm,psi}',
                saveAs: { filename -> (['fastq', 'transcriptome_bam'].contains(params.source) && params.aligner == "star_salmon" && params.suppa && params.suppa_per_local_event) ? filename : null }
            ],
            [
                path: { "${params.outdir}/${params.aligner}/suppa/split_files/per_isoform" },
                mode: params.publish_dir_mode,
                pattern: 'transcript*.{tpm,psi}',
                saveAs: { filename -> (['fastq', 'transcriptome_bam'].contains(params.source) && params.aligner == "star_salmon" && params.suppa && params.suppa_per_isoform) ? filename : null }
            ],
            [
                path: { "${params.outdir}/${params.aligner}/suppa/split_files/tpms" },
                mode: params.publish_dir_mode,
                pattern: '*.tpm',
                saveAs: { filename -> (['fastq', 'transcriptome_bam'].contains(params.source) && params.aligner == "star_salmon" && params.suppa) ? filename : null }
            ]
        ]
    }

    withName: '.*:SUPPA_STAR_SALMON:SPLIT_FILES_TPM' {
        ext.prefix = ''
    }

    withName: '.*:SUPPA_STAR_SALMON:SPLIT_FILES_IOE' {
        ext.prefix = 'local'
    }

    withName: '.*:SUPPA_STAR_SALMON:SPLIT_FILES_IOI' {
        ext.prefix = 'transcript'
    }

    withName: '.*:SUPPA_STAR_SALMON:CLUSTERGROUPS_(IOE|IOI)' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.aligner}/suppa/clustergroups" },
                mode: params.publish_dir_mode,
                pattern: '*_groups.txt',
                saveAs: { filename -> (['fastq', 'transcriptome_bam'].contains(params.source) && params.aligner == "star_salmon" && params.suppa) ? filename : null }
            ]
        ]
    }

    withName: '.*:SUPPA_STAR_SALMON:DIFFSPLICE_(IOE|IOI)' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.aligner}/suppa/diffsplice/per_local_event" },
                mode: params.publish_dir_mode,
                pattern: '*local*.{dpsi,psivec}',
                saveAs: { filename -> (['fastq', 'transcriptome_bam'].contains(params.source) && params.aligner == "star_salmon" && params.suppa && params.suppa_per_local_event) ? filename : null }
            ],
            [
                path: { "${params.outdir}/${params.aligner}/suppa/diffsplice/per_isoform" },
                mode: params.publish_dir_mode,
                pattern: '*transcript*.{dpsi,psivec}',
                saveAs: { filename -> (['fastq', 'transcriptome_bam'].contains(params.source) && params.aligner == "star_salmon" && params.suppa && params.suppa_per_isoform) ? filename : null }
            ]
        ]
    }

    withName: '.*:SUPPA_STAR_SALMON:CLUSTEREVENTS_(IOE|IOI)' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.aligner}/suppa/clusterevents/per_local_event" },
                mode: params.publish_dir_mode,
                pattern: '*local*.{clustvec,log}',
                saveAs: { filename -> (['fastq', 'transcriptome_bam'].contains(params.source) && params.aligner == "star_salmon" && params.suppa && params.suppa_per_local_event) ? filename : null }
            ],
            [
                path: { "${params.outdir}/${params.aligner}/suppa/clusterevents/per_isoform" },
                mode: params.publish_dir_mode,
                pattern: '*transcript*.{clustvec,log}',
                saveAs: { filename -> (['fastq', 'transcriptome_bam'].contains(params.source) && params.aligner == "star_salmon" && params.suppa && params.suppa_per_isoform) ? filename : null }
            ]
        ]
    }

    // --- SUPPA (Pure Salmon Path) ---
    withName: '.*:SUPPA_SALMON:SUPPA_GENERATEEVENTS_(IOE|IOI)' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.pseudo_aligner}/suppa/generate_events/per_local_event" },
                mode: params.publish_dir_mode,
                pattern: '*.{ioe,gtf}',
                saveAs: { filename -> (['fastq', 'salmon_results'].contains(params.source) && params.pseudo_aligner == "salmon" && params.suppa && params.suppa_per_local_event) ? filename : null }
            ],
            [
                path: { "${params.outdir}/${params.pseudo_aligner}/suppa/generate_events/per_isoform" },
                mode: params.publish_dir_mode,
                pattern: '*.ioi',
                saveAs: { filename -> (['fastq', 'salmon_results'].contains(params.source) && params.pseudo_aligner == "salmon" && params.suppa && params.suppa_per_isoform) ? filename : null }
            ]
        ]
    }

    withName: '.*:SUPPA_SALMON:SUPPA_MERGEEVENTS' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.pseudo_aligner}/suppa/generate_events/per_local_event/merged_events" },
                mode: params.publish_dir_mode,
                pattern: '*.{ioe,gtf}',
                saveAs: { filename -> (['fastq', 'salmon_results'].contains(params.source) && params.pseudo_aligner == "salmon" && params.suppa && params.suppa_per_local_event) ? filename : null }
            ],
            [
                path: { "${params.outdir}/${params.pseudo_aligner}/suppa/generate_events/per_isoform/merged_events" },
                mode: params.publish_dir_mode,
                pattern: '*.ioi',
                saveAs: { filename -> (['fastq', 'salmon_results'].contains(params.source) && params.pseudo_aligner == "salmon" && params.suppa && params.suppa_per_isoform) ? filename : null }
            ]
        ]
    }

    withName: '.*:SUPPA_SALMON:SUPPA_PSIPEREVENT' {
        publishDir = [
            path: { "${params.outdir}/${params.pseudo_aligner}/suppa/psi_per_local_event" },
            mode: params.publish_dir_mode,
            pattern: '*.psi',
            saveAs: { filename -> (['fastq', 'salmon_results'].contains(params.source) && params.pseudo_aligner == "salmon" && params.suppa && params.suppa_per_local_event) ? filename : null }
        ]
    }

    withName: '.*:SUPPA_SALMON:SUPPA_PSIPERISOFORM' {
        publishDir = [
            path: { "${params.outdir}/${params.pseudo_aligner}/suppa/psi_per_isoform" },
            mode: params.publish_dir_mode,
            pattern: '*.psi',
            saveAs: { filename -> (['fastq', 'salmon_results'].contains(params.source) && params.pseudo_aligner == "salmon" && params.suppa && params.suppa_per_isoform) ? filename : null }
        ]
    }

    withName: '.*:SUPPA_SALMON:SPLIT_FILES_(TPM|IOE|IOI)' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.pseudo_aligner}/suppa/split_files/per_local_event" },
                mode: params.publish_dir_mode,
                pattern: 'local*.{tpm,psi}',
                saveAs: { filename -> (['fastq', 'salmon_results'].contains(params.source) && params.pseudo_aligner == "salmon" && params.suppa && params.suppa_per_local_event) ? filename : null }
            ],
            [
                path: { "${params.outdir}/${params.pseudo_aligner}/suppa/split_files/per_isoform" },
                mode: params.publish_dir_mode,
                pattern: 'transcript*.{tpm,psi}',
                saveAs: { filename -> (['fastq', 'salmon_results'].contains(params.source) && params.pseudo_aligner == "salmon" && params.suppa && params.suppa_per_isoform) ? filename : null }
            ],
            [
                path: { "${params.outdir}/${params.pseudo_aligner}/suppa/split_files/tpms" },
                mode: params.publish_dir_mode,
                pattern: '*.tpm',
                saveAs: { filename -> (['fastq', 'salmon_results'].contains(params.source) && params.pseudo_aligner == "salmon" && params.suppa) ? filename : null }
            ]
        ]
    }

    withName: '.*:SUPPA_SALMON:SPLIT_FILES_TPM' {
        ext.prefix = ''
    }

    withName: '.*:SUPPA_SALMON:SPLIT_FILES_IOE' {
        ext.prefix = 'local'
    }

    withName: '.*:SUPPA_SALMON:SPLIT_FILES_IOI' {
        ext.prefix = 'transcript'
    }

    withName: '.*:SUPPA_SALMON:CLUSTERGROUPS_(IOE|IOI)' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.pseudo_aligner}/suppa/clustergroups" },
                mode: params.publish_dir_mode,
                pattern: '*_groups.txt',
                saveAs: { filename -> (['fastq', 'transcriptome_bam'].contains(params.source) && params.pseudo_aligner == "salmon" && params.suppa) ? filename : null }
            ]
        ]
    }

    withName: '.*:SUPPA_SALMON:DIFFSPLICE_(IOE|IOI)' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.pseudo_aligner}/suppa/diffsplice/per_local_event" },
                mode: params.publish_dir_mode,
                pattern: '*local*.{dpsi,psivec}',
                saveAs: { filename -> (['fastq', 'salmon_results'].contains(params.source) && params.pseudo_aligner == "salmon" && params.suppa && params.suppa_per_local_event) ? filename : null }
            ],
            [
                path: { "${params.outdir}/${params.pseudo_aligner}/suppa/diffsplice/per_isoform" },
                mode: params.publish_dir_mode,
                pattern: '*transcript*.{dpsi,psivec}',
                saveAs: { filename -> (['fastq', 'salmon_results'].contains(params.source) && params.pseudo_aligner == "salmon" && params.suppa && params.suppa_per_isoform) ? filename : null }
            ]
        ]
    }

    withName: '.*:SUPPA_SALMON:CLUSTEREVENTS_(IOE|IOI)' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.pseudo_aligner}/suppa/clusterevents/per_local_event" },
                mode: params.publish_dir_mode,
                pattern: '*local*.{clustvec,log}',
                saveAs: { filename -> (['fastq', 'salmon_results'].contains(params.source) && params.pseudo_aligner == "salmon" && params.suppa && params.suppa_per_local_event) ? filename : null }
            ],
            [
                path: { "${params.outdir}/${params.pseudo_aligner}/suppa/clusterevents/per_isoform" },
                mode: params.publish_dir_mode,
                pattern: '*transcript*.{clustvec,log}',
                saveAs: { filename -> (['fastq', 'salmon_results'].contains(params.source) && params.pseudo_aligner == "salmon" && params.suppa && params.suppa_per_isoform) ? filename : null }
            ]
        ]
    }

    // --- Tximport Tracks ---
    withName: '.*:TX2GENE_TXIMPORT_STAR_SALMON:TXIMPORT' {
        ext.args  = { params.ignore_tx_version ? '--ignore_tx_version true' : '--ignore_tx_version false' }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/tximport" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!(['fastq', 'transcriptome_bam'].contains(params.source) && params.aligner == "star_salmon")) return null
                return filename
            }
        ]
    }

    withName: '.*:TX2GENE_TXIMPORT_SALMON:UNTAR' {
        publishDir = [
            path: { "${params.outdir}/${params.pseudo_aligner}/tximport" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!(['fastq', 'salmon_results'].contains(params.source) && params.pseudo_aligner == "salmon")) return null
                return filename
            }
        ]
    }

    withName: '.*:TX2GENE_TXIMPORT_SALMON:TXIMPORT' {
        ext.args  = { params.ignore_tx_version ? '--ignore_tx_version true' : '--ignore_tx_version false' }
        publishDir = [
            path: { "${params.outdir}/${params.pseudo_aligner}/tximport" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!(['fastq', 'salmon_results'].contains(params.source) && params.pseudo_aligner == "salmon")) return null
                return filename
            }
        ]
    }

    // --- MISO / Sashimi Plots ---
    withName: 'GFFREAD_GTF2GFF3' {
        ext.args   = '-L --keep-genes'
        ext.prefix = { "${meta.id}_genes" }
        publishDir = [
            path: { "${params.outdir}/misopy" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!(['fastq', 'genome_bam'].contains(params.source) && params.sashimi_plot)) return null
                return filename
            }
        ]
    }

    withName: 'MISOPY_INDEX' {
        publishDir = [
            path: { "${params.outdir}/misopy" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!(['fastq', 'genome_bam'].contains(params.source) && params.sashimi_plot)) return null
                return filename
            }
        ]
    }

    withName: 'MISOPY_RUN' {
        ext.args = { "--read-len ${params.miso_read_len}" }
        publishDir = [
            path: { "${params.outdir}/misopy" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!(['fastq', 'genome_bam'].contains(params.source) && params.sashimi_plot)) return null
                return filename
            }
        ]
    }

    withName: 'MISOPY_SETTINGS' {
        ext.args   = [ "--bam_prefix .", "--miso_prefix ." ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/misopy" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!(['fastq', 'genome_bam'].contains(params.source) && params.sashimi_plot)) return null
                return filename
            }        ]
    }

    withName: 'MISOPY_SASHIMIPLOT' {
        publishDir = [
            path: { "${params.outdir}/misopy/sashimi" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!(['fastq', 'genome_bam'].contains(params.source) && params.sashimi_plot)) return null
                return filename
            }
        ]
    }
}
