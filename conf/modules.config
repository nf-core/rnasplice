/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    // Global default fallback publishing directory layout
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // ====================================================================
    // CORE QUALITY CONTROL & INFRASTRUCTURE
    // ====================================================================

    withName: 'FASTQC' {
        ext.args   = '--quiet'
        publishDir = [
            path: { "${params.outdir}/fastqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (params.skip_fastqc) return null
                return filename
            }
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*:FASTQ_FASTQC_UMITOOLS_TRIMGALORE:TRIMGALORE' {
        ext.args   = { [
            params.skip_trimgalore_fastqc ? "" : '--fastqc',
            params.trim_nextseq > 0 ? "--nextseq ${params.trim_nextseq}" : '',
            params.clip_r1 ? "--clip_R1 ${params.clip_r1}" : '',
            params.clip_r2 ? "--clip_R2 ${params.clip_r2}" : '',
        ].join(' ').trim() }
        publishDir = [
            [
                path: { "${params.outdir}/trimgalore/fastqc" },
                mode: params.publish_dir_mode,
                pattern: "*.{html,zip}",
                saveAs: { filename -> (!params.skip_trimming) ? filename : null }
            ],
            [
                path: { "${params.outdir}/trimgalore" },
                mode: params.publish_dir_mode,
                pattern: "*.fq.gz",
                saveAs: { filename -> (!params.skip_trimming && params.save_trimmed) ? filename : null }
            ],
            [
                path: { "${params.outdir}/trimgalore" },
                mode: params.publish_dir_mode,
                pattern: "*.txt",
                saveAs: { filename -> (!params.skip_trimming) ? filename : null }
            ]
        ]
    }

    // ====================================================================
    // GENOME INDEXING & REFERENCE PREPARATION
    // ====================================================================

    withName: 'GUNZIP_.*|MAKE_TRANSCRIPTS_FASTA' {
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!params.save_reference) return null
                return filename
            }
        ]
    }

    withName: 'UNTAR_.*' {
        ext.args2 = '--no-same-owner'
    }

    withName: 'UNTAR_.*|STAR_GENOMEGENERATE|GENOMEPARAMSUPGRADE' {
        publishDir = [
            path: { "${params.outdir}/genome/index" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!params.save_reference) return null
                return filename
            }
        ]
    }

    withName: 'GFFREAD' {
        ext.args   = '--keep-exon-attrs -F -T'
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!params.save_reference) return null
                return filename
            }
        ]
    }

    // The annotation tables are published with every run, as a reference of the gene names
    withName: 'GENEANNOTATION_TABLES' {
        publishDir = [
            path: { "${params.outdir}/annotation" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GFFREAD_TX2GENE' {
        ext.args   = { "--table transcript_id,${params.gtf_group_features},${params.gtf_extra_attributes},gene_biotype,gene_type" }
        ext.prefix = { "${meta.id}.tx2gene" }
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!params.save_reference) return null
                return filename
            }
        ]
    }

    withName: 'SALMON_INDEX' {
        ext.args   = { params.gencode ? '--gencode' : '' }
        publishDir = [
            path: { "${params.outdir}/genome/index" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!params.save_reference) return null
                return filename
            }
        ]
    }

    withName: 'CAT_FASTQ' {
        publishDir = [
            path: { "${params.outdir}/fastq" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!params.save_merged_fastq) return null
                return filename
            }
        ]
    }

    withName: 'SAMTOOLS_FAIDX|SAMTOOLS_FAIDX_TRANSCRIPTS' {
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!params.save_reference) return null
                return filename
            }
        ]
    }

    withName: 'SEQKIT_REPLACE' {
        ext.args   = "-p '\\|.*' -r ''"
        ext.prefix = { "${meta.id}.fixed" }
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!params.save_reference) return null
                return filename
            }
        ]
    }

    // ====================================================================
    // ALIGNMENT & QUANTIFICATION MODULES
    // ====================================================================

    withName: 'STAR_ALIGN' {
        ext.args   = {
            // Without `--seq_center` the module writes its default `ID` and `SM` read group tags
            def prefix = task.ext.prefix ?: meta.id
            def read_group = params.seq_center ? "--outSAMattrRGline 'ID:${prefix}' 'SM:${prefix}' 'CN:${params.seq_center}'" : ''
            [
                '--quantMode TranscriptomeSAM',
                '--twopassMode Basic',
                '--outSAMtype BAM Unsorted',
                '--readFilesCommand gunzip -c',
                '--runRNGseed 0',
                '--outFilterMultimapNmax 20',
                '--alignSJDBoverhangMin 1',
                '--outSAMattributes NH HI AS NM MD',
                '--quantTranscriptomeSAMoutput BanSingleEnd',
                read_group,
                params.save_unaligned ? '--outReadsUnmapped Fastx' : '',
                // Without `--max_intron_length` STAR's default limit is about 590 kb,
                // whatever the genome size
                params.max_intron_length ? "--alignIntronMax ${params.max_intron_length} --alignMatesGapMax ${params.max_intron_length}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            [
                path: { "${params.outdir}/${params.aligner}/log" },
                mode: params.publish_dir_mode,
                pattern: '*.{out,tab}'
            ],
            [
                path: { "${params.outdir}/${params.aligner}" },
                mode: params.publish_dir_mode,
                pattern: '*.bam',
                saveAs: { filename -> params.save_align_intermeds ? filename : null }
            ],
            [
                path: { "${params.outdir}/${params.aligner}/unmapped" },
                mode: params.publish_dir_mode,
                pattern: '*.fastq.gz',
                saveAs: { filename -> params.save_unaligned ? filename : null }
            ]
        ]
    }

    // Only read to check the BAM files against the references
    withName: 'SAMTOOLS_SPLITHEADER_.*' {
        publishDir = [ enabled: false ]
    }

    withName: '.*:BAM_STATS_SAMTOOLS:SAMTOOLS_.*' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/samtools_stats" },
            mode: params.publish_dir_mode,
            pattern: "*.{stats,flagstat,idxstats}"
        ]
    }

    withName: 'SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}_sorted" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}" },
            mode: params.publish_dir_mode,
            pattern: "*.bam"
        ]
    }

    withName: 'SAMTOOLS_INDEX' {
        ext.args   = { params.bam_csi_index ? '-c' : '' }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}" },
            mode: params.publish_dir_mode,
            pattern: "*.{bai,csi}"
        ]
    }

    // Salmon quantifies the transcriptome BAM files as STAR writes them, so they are not sorted
    withName: '.*:FASTQ_ALIGN_STAR:BAM_SORT_STATS_SAMTOOLS_TRANSCRIPTOME:.*' {
        ext.when = false
    }

    withName: 'SALMON_QUANT_STAR|SALMON_QUANT_STAR_AUTO' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/salmon" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                return filename
            },
        ]
    }

    // Strandedness inference of the 'auto' samples, set as in nf-core/rnaseq
    withName: '.*:FASTQ_SUBSAMPLE_FQ_SALMON:FQ_SUBSAMPLE' {
        ext.args   = '--record-count 1000000 --seed 1'
        ext.prefix = { "${meta.id}.subsampled" }
        publishDir = [
            enabled: false
        ]
    }

    withName: '.*:FASTQ_SUBSAMPLE_FQ_SALMON:SALMON_QUANT' {
        ext.args   = '--skipQuant'
        publishDir = [
            enabled: false
        ]
    }

    withName: 'GFFREAD_GTF2BED' {
        ext.args   = '--bed'
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!params.save_reference) return null
                return filename
            }
        ]
    }

    withName: 'RSEQC_INFEREXPERIMENT' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/rseqc/infer_experiment" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SALMON_QUANT_SALMON' {
        publishDir = [
            path: { "${params.outdir}/${params.pseudo_aligner}" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                return filename
            }
        ]
    }

    // ====================================================================
    // COVERAGE TRACK GENERATION
    // ====================================================================

    withName: 'BEDTOOLS_GENOMECOV' {
        ext.args   = '-split -du -bg'
        publishDir = [
            path: { "${params.outdir}/bedtools/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> null }
        ]
    }

    withName: 'BEDTOOLS_GENOMECOV_FORWARD' {
        ext.args   = '-split -du -bg -strand +'
        publishDir = [
            path: { "${params.outdir}/bedtools/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> null }
        ]
    }

    withName: 'BEDTOOLS_GENOMECOV_REVERSE' {
        ext.args   = '-split -du -bg -strand -'
        publishDir = [
            path: { "${params.outdir}/bedtools/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> null }
        ]
    }

    withName: '.*:BEDGRAPH_TO_BIGWIG_FORWARD:UCSC_BEDCLIP' {
        ext.prefix = { "${meta.id}.clip.forward" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> null }
        ]
    }

    withName: '.*:BEDGRAPH_TO_BIGWIG_FORWARD:UCSC_BEDGRAPHTOBIGWIG' {
        ext.prefix = { "${meta.id}.forward" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/bigwig" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (params.skip_bigwig) return null
                return filename
            }
        ]
    }

    withName: '.*:BEDGRAPH_TO_BIGWIG_REVERSE:UCSC_BEDCLIP' {
        ext.prefix = { "${meta.id}.clip.reverse" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> null }
        ]
    }

    withName: '.*:BEDGRAPH_TO_BIGWIG_REVERSE:UCSC_BEDGRAPHTOBIGWIG' {
        ext.prefix = { "${meta.id}.reverse" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/bigwig" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (params.skip_bigwig) return null
                return filename
            }
        ]
    }

    // ====================================================================
    // SPLICING ENGINES & DOWNSTREAM COHORTS
    // ====================================================================

    // --- rMATS ---
    // `--novelSS` and its `--mil`/`--mel` limits shape the splicing graph in both steps,
    // so they are given to both. The library options only matter to the prep step and
    // the statistical model only to the post step
    withName: 'RMATS_PREP' {
        ext.args = { [
            '--variable-read-length',
            '--allow-clipping',
            "-t ${meta.single_end ? 'single' : 'paired'}",
            "--libType ${meta.strandedness == 'forward' ? 'fr-secondstrand' : meta.strandedness == 'reverse' ? 'fr-firststrand' : 'fr-unstranded'}",
            params.rmats_novel_splice_site ? "--novelSS --mil ${params.rmats_min_intron_len} --mel ${params.rmats_max_exon_len}" : '',
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/rmats/prep" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> params.rmats ? filename : null }
        ]
    }

    withName: 'RMATS_POST' {
        ext.args = { [
            "--cstat ${params.rmats_splice_diff_cutoff}",
            meta.paired ? '--paired-stats' : '',
            params.rmats_novel_splice_site ? "--novelSS --mil ${params.rmats_min_intron_len} --mel ${params.rmats_max_exon_len}" : '',
        ].join(' ').trim() }
        ext.prefix = { meta.paired ? "${meta.id}_paired" : "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/rmats" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> params.rmats ? filename : null }
        ]
    }

    withName: 'CREATEBAMLIST' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/rmats/bamlist" },
            mode: params.publish_dir_mode,
            pattern: "*.txt",
            saveAs: { filename -> params.rmats ? filename : null }
        ]
    }

    // --- Leafcutter ---
    // The intron limit of LeafCutter is `--leafcutter_max_intron_len`, or else
    // `--max_intron_length`, or else 500 kb
    withName: 'REGTOOLS_JUNCTIONSEXTRACT_(FR|RF|XS)' {
        ext.args   = { "-a 8 -m 50 -M ${params.leafcutter_max_intron_len ?: params.max_intron_length ?: 500000}" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/leafcutter" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> params.leafcutter ? filename : null }
        ]
    }

    // An unstranded sample has no strand in its junctions until `STRANDJUNCTIONS` has
    // read the splice motifs, so what regtools writes for it is an intermediate and only
    // the stranded file is published, under the same name a stranded sample gets
    withName: 'REGTOOLS_JUNCTIONSEXTRACT_XS' {
        publishDir = [
            enabled: false
        ]
    }

    withName: 'STRANDJUNCTIONS' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/leafcutter" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> ((filename.endsWith('.junc') || filename.endsWith('.strand_summary.tsv')) && params.leafcutter) ? filename.tokenize('/').last() : null }
        ]
    }

    withName: 'LEAFCUTTER_CLUSTERREGTOOLS' {
        ext.args   = { "-l ${params.leafcutter_max_intron_len ?: params.max_intron_length ?: 500000} -m ${params.leafcutter_min_cluster_reads} -p ${params.leafcutter_min_cluster_ratio}" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/leafcutter" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> params.leafcutter ? filename : null }
        ]
    }

    withName: 'LEAFCUTTER_GTFTOEXONS' {
        publishDir = [
            enabled: false
        ]
    }

    // `-0` makes the control the baseline, so that ΔPSI is treatment minus control
    withName: 'LEAFCUTTER_DIFFERENTIALSPLICING' {
        ext.args   = { "-0 ${meta.control} -i ${params.leafcutter_ds_min_samples_per_intron} -g ${params.leafcutter_ds_min_samples_per_group} -c ${params.leafcutter_ds_min_coverage}" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/leafcutter" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> params.leafcutter ? filename : null }
        ]
    }

    // --- ASpli ---
    // The options of the ASpli functions are set with `ext.args`, see the templates of
    // the two modules for the ones each of them accepts
    withName: 'ASPLI_COUNTS' {
        // One cpu, as most of the counting runs on one core, with the memory and time of
        // process_high because every BAM file is read into memory in full
        memory     = { 72.GB * task.attempt }
        time       = { 16.h  * task.attempt }
        // The intron limit of ASpli is `--aspli_max_intron_len`, or else `--max_intron_length`,
        // or else 50 kb
        ext.args   = { "--max_intron_size ${params.aspli_max_intron_len ?: params.max_intron_length ?: 50000} --min_anchor 10 --junction_threshold 5" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/aspli/counts" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!params.aspli) return null
                return filename
            }
        ]
    }

    withName: 'ASPLI_DU' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/aspli/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!params.aspli) return null
                return filename
            }
        ]
    }

    // --- DEXSeq Exon ---
    withName: 'DEXSEQ_PREPAREANNOTATION' {
        ext.args   = { params.aggregation ? '' : '--aggregate no' }
        ext.prefix = 'DEXSeq'
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/dexseq_exon/annotation" },
            mode: params.publish_dir_mode,
            pattern: "*.gff",
            saveAs: { filename -> (params.dexseq_exon && params.save_dexseq_annotation) ? filename : null }
        ]
    }

    withName: 'DEXSEQ_COUNT' {
        ext.args   = { [
            "--minaqual ${params.alignment_quality}",
            ['forward': '--stranded yes', 'reverse': '--stranded reverse', 'unstranded': '--stranded no'][meta.strandedness] ?: ''
        ].join(' ').trim() }
        ext.prefix = { "${meta.id}.clean.count" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/dexseq_exon/counts" },
            mode: params.publish_dir_mode,
            pattern: "*.clean.count.txt",
            saveAs: { filename -> params.dexseq_exon ? filename : null }
        ]
    }

    withName: 'DEXSEQ_EXON' {
        // The count tables are named after `ext.prefix` of DEXSEQ_COUNT
        ext.args   = { [
            "--count_suffix .clean.count.txt --n_plot ${params.n_dexseq_plot}",
            meta.blocking ? "--blocking_variables ${meta.blocking}" : ''
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/dexseq_exon/results" },
            mode: params.publish_dir_mode,
            pattern: "*.{tsv,pdf,rds}",
            saveAs: { filename -> params.dexseq_exon ? filename : null }
        ]
    }

    withName: '.*:DEXSEQ_DEU:GENEANNOTATION_ANNOTATE' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/dexseq_exon/results" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> (filename != 'versions.yml' && params.dexseq_exon) ? filename : null }
        ]
    }

    withName: 'DEXSEQ_DTU' {
        ext.args   = { meta.blocking ? "--blocking_variables ${meta.blocking}" : '' }
    }

    // --- DEXSeq DTU (STAR/Salmon Paths) ---
    withName: '.*:DRIMSEQ_DEXSEQ_DTU_STAR_SALMON:DRIMSEQ_DMFILTER' {
        ext.args   = { [
            "--min_samps_gene_expr ${params.min_samps_gene_expr}",
            "--min_samps_feature_expr ${params.min_samps_feature_expr}",
            "--min_samps_feature_prop ${params.min_samps_feature_prop}",
            "--min_feature_expr ${params.min_feature_expr}",
            "--min_feature_prop ${params.min_feature_prop}",
            "--min_gene_expr ${params.min_gene_expr}"
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/dexseq_dtu/filter/drimseq" },
            mode: params.publish_dir_mode,
            pattern: "*.rds",
            saveAs: { filename -> params.dexseq_dtu ? filename : null }
        ]
    }

    withName: '.*:DRIMSEQ_DEXSEQ_DTU_STAR_SALMON:DEXSEQ_DTU' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/dexseq_dtu/results/dexseq" },
            mode: params.publish_dir_mode,
            pattern: "*.{tsv,rds}",
            saveAs: { filename -> params.dexseq_dtu ? filename : null }
        ]
    }

    withName: '.*:DRIMSEQ_DEXSEQ_DTU_STAR_SALMON:STAGER' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/dexseq_dtu/results/stager" },
            mode: params.publish_dir_mode,
            pattern: "*.{tsv,rds}",
            saveAs: { filename -> params.dexseq_dtu ? filename : null }
        ]
    }

    withName: '.*:DRIMSEQ_DEXSEQ_DTU_STAR_SALMON:GENEANNOTATION_ANNOTATE_DEXSEQ' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/dexseq_dtu/results/dexseq" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> (filename != 'versions.yml' && params.dexseq_dtu) ? filename : null }
        ]
    }

    withName: '.*:DRIMSEQ_DEXSEQ_DTU_STAR_SALMON:GENEANNOTATION_ANNOTATE_STAGER' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/dexseq_dtu/results/stager" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> (filename != 'versions.yml' && params.dexseq_dtu) ? filename : null }
        ]
    }

    // --- DEXSeq DTU (Pure Salmon Paths) ---
    withName: '.*:DRIMSEQ_DEXSEQ_DTU_SALMON:DRIMSEQ_DMFILTER' {
        ext.args   = { [
            "--min_samps_gene_expr ${params.min_samps_gene_expr}",
            "--min_samps_feature_expr ${params.min_samps_feature_expr}",
            "--min_samps_feature_prop ${params.min_samps_feature_prop}",
            "--min_feature_expr ${params.min_feature_expr}",
            "--min_feature_prop ${params.min_feature_prop}",
            "--min_gene_expr ${params.min_gene_expr}"
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/${params.pseudo_aligner}/dexseq_dtu/filter/drimseq" },
            mode: params.publish_dir_mode,
            pattern: "*.rds",
            saveAs: { filename -> params.dexseq_dtu ? filename : null }
        ]
    }

    withName: '.*:DRIMSEQ_DEXSEQ_DTU_SALMON:DEXSEQ_DTU' {
        publishDir = [
            path: { "${params.outdir}/${params.pseudo_aligner}/dexseq_dtu/results/dexseq" },
            mode: params.publish_dir_mode,
            pattern: "*.{tsv,rds}",
            saveAs: { filename -> params.dexseq_dtu ? filename : null }
        ]
    }

    withName: '.*:DRIMSEQ_DEXSEQ_DTU_SALMON:STAGER' {
        publishDir = [
            path: { "${params.outdir}/${params.pseudo_aligner}/dexseq_dtu/results/stager" },
            mode: params.publish_dir_mode,
            pattern: "*.{tsv,rds}",
            saveAs: { filename -> params.dexseq_dtu ? filename : null }
        ]
    }

    withName: '.*:DRIMSEQ_DEXSEQ_DTU_SALMON:GENEANNOTATION_ANNOTATE_DEXSEQ' {
        publishDir = [
            path: { "${params.outdir}/${params.pseudo_aligner}/dexseq_dtu/results/dexseq" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> (filename != 'versions.yml' && params.dexseq_dtu) ? filename : null }
        ]
    }

    withName: '.*:DRIMSEQ_DEXSEQ_DTU_SALMON:GENEANNOTATION_ANNOTATE_STAGER' {
        publishDir = [
            path: { "${params.outdir}/${params.pseudo_aligner}/dexseq_dtu/results/stager" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> (filename != 'versions.yml' && params.dexseq_dtu) ? filename : null }
        ]
    }

    // --- edgeR DEU ---
    withName: 'SUBREAD_FLATTENGTF' {
        ext.args   = { [ "-t exon", "-g ${params.gtf_group_features}", '-C' ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/featurecounts" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!params.edger_exon) return null
                return filename
            }
        ]
    }

    withName: 'SUBREAD_FEATURECOUNTS' {
        ext.args   = { [ '-F SAF', "-t exon", "-g ${params.gtf_group_features}", '-f', '-O', '-B', '-C' ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/featurecounts" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!params.edger_exon) return null
                return filename
            }
        ]
    }

    withName: 'CSVTK_JOIN' {
        ext.args   = '--tabs --out-tabs --fields "Geneid,Chr,Start,End,Strand,Length"'
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/edger" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> (filename != 'versions.yml' && params.edger_exon) ? filename : null }
        ]
    }

    withName: 'EDGER_DIFFSPLICE' {
        ext.args   = { [
            '--sample_id_col sample',
            '--gene_id_col Geneid',
            '--feature_id_col Start',
            '--annotation_cols Chr;End;Strand;Length',
            '--filter_by_expr TRUE',
            '--robust FALSE',
            "--plot_n ${params.n_edger_plot}",
            meta.blocking ? "--blocking_variables ${meta.blocking}" : '',
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/edger" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> (filename != 'versions.yml' && params.edger_exon) ? filename : null }
        ]
    }

    withName: '.*:EDGER_DEU:GENEANNOTATION_ANNOTATE' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/edger" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> (filename != 'versions.yml' && params.edger_exon) ? filename : null }
        ]
    }

    // --- IsoformSwitchAnalyzeR ---
    withName: 'ISOFORMSWITCHANALYZER' {
        publishDir = [
            path: { "${params.outdir}/isoformswitchanalyzer/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // --- SUPPA (STAR/Salmon Path) ---
    withName: '.*:SUPPA_STAR_SALMON:SUPPA_GENERATEEVENTS_(IOE|IOI)' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.aligner}/suppa/generate_events/per_local_event" },
                mode: params.publish_dir_mode,
                pattern: '*.{ioe,gtf}',
                saveAs: { filename -> (params.suppa && params.suppa_per_local_event) ? filename : null }
            ],
            [
                path: { "${params.outdir}/${params.aligner}/suppa/generate_events/per_isoform" },
                mode: params.publish_dir_mode,
                pattern: '*.ioi',
                saveAs: { filename -> (params.suppa && params.suppa_per_isoform) ? filename : null }
            ]
        ]
    }

    withName: '.*:SUPPA_STAR_SALMON:MERGEEVENTS' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/suppa/generate_events/per_local_event/merged_events" },
            mode: params.publish_dir_mode,
            pattern: '*.ioe',
            saveAs: { filename -> (params.suppa && params.suppa_per_local_event) ? filename : null }
        ]
    }

    withName: '.*:SUPPA_STAR_SALMON:SUPPA_PSIPEREVENT' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/suppa/psi_per_local_event" },
            mode: params.publish_dir_mode,
            pattern: '*.psi',
            saveAs: { filename -> (params.suppa && params.suppa_per_local_event) ? filename : null }
        ]
    }

    withName: '.*:SUPPA_STAR_SALMON:SUPPA_PSIPERISOFORM' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/suppa/psi_per_isoform" },
            mode: params.publish_dir_mode,
            pattern: '*.psi',
            saveAs: { filename -> (params.suppa && params.suppa_per_isoform) ? filename : null }
        ]
    }

    withName: '.*:SUPPA_STAR_SALMON:SPLITFILES_(TPM|PSI)' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.aligner}/suppa/split_files/per_local_event" },
                mode: params.publish_dir_mode,
                pattern: 'local*.{tpm,psi}',
                saveAs: { filename -> (params.suppa && params.suppa_per_local_event) ? filename : null }
            ],
            [
                path: { "${params.outdir}/${params.aligner}/suppa/split_files/per_isoform" },
                mode: params.publish_dir_mode,
                pattern: 'transcript*.{tpm,psi}',
                saveAs: { filename -> (params.suppa && params.suppa_per_isoform) ? filename : null }
            ],
            [
                path: { "${params.outdir}/${params.aligner}/suppa/split_files/tpms" },
                mode: params.publish_dir_mode,
                pattern: '*.tpm',
                saveAs: { filename -> params.suppa ? filename : null }
            ]
        ]
    }

    withName: '.*:SUPPA_STAR_SALMON:SPLITFILES_TPM' {
        ext.prefix = { meta.condition }
    }

    withName: '.*:SUPPA_STAR_SALMON:CLUSTERGROUPS' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.aligner}/suppa/clustergroups" },
                mode: params.publish_dir_mode,
                pattern: '*_groups.txt',
                saveAs: { filename -> params.suppa ? filename : null }
            ]
        ]
    }

    withName: '.*:SUPPA_STAR_SALMON:SUPPA_DIFFSPLICE' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.aligner}/suppa/diffsplice/per_local_event" },
                mode: params.publish_dir_mode,
                pattern: '*local*.{dpsi,psivec}',
                saveAs: { filename -> (params.suppa && params.suppa_per_local_event) ? filename : null }
            ],
            [
                path: { "${params.outdir}/${params.aligner}/suppa/diffsplice/per_isoform" },
                mode: params.publish_dir_mode,
                pattern: '*transcript*.{dpsi,psivec}',
                saveAs: { filename -> (params.suppa && params.suppa_per_isoform) ? filename : null }
            ]
        ]
    }

    withName: '.*:SUPPA_STAR_SALMON:GENEANNOTATION_ANNOTATE' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.aligner}/suppa/diffsplice/per_local_event" },
                mode: params.publish_dir_mode,
                pattern: 'local_*.annotated.tsv',
                saveAs: { filename -> (params.suppa && params.suppa_per_local_event) ? filename : null }
            ],
            [
                path: { "${params.outdir}/${params.aligner}/suppa/diffsplice/per_isoform" },
                mode: params.publish_dir_mode,
                pattern: 'transcript_*.annotated.tsv',
                saveAs: { filename -> (params.suppa && params.suppa_per_isoform) ? filename : null }
            ]
        ]
    }

    withName: '.*:SUPPA_STAR_SALMON:SUPPA_CLUSTEREVENTS' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.aligner}/suppa/clusterevents/per_local_event" },
                mode: params.publish_dir_mode,
                pattern: '*local*.{clustvec,log}',
                saveAs: { filename -> (params.suppa && params.suppa_per_local_event) ? filename : null }
            ],
            [
                path: { "${params.outdir}/${params.aligner}/suppa/clusterevents/per_isoform" },
                mode: params.publish_dir_mode,
                pattern: '*transcript*.{clustvec,log}',
                saveAs: { filename -> (params.suppa && params.suppa_per_isoform) ? filename : null }
            ]
        ]
    }

    // --- SUPPA (Pure Salmon Path) ---
    withName: '.*:SUPPA_SALMON:SUPPA_GENERATEEVENTS_(IOE|IOI)' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.pseudo_aligner}/suppa/generate_events/per_local_event" },
                mode: params.publish_dir_mode,
                pattern: '*.{ioe,gtf}',
                saveAs: { filename -> (params.suppa && params.suppa_per_local_event) ? filename : null }
            ],
            [
                path: { "${params.outdir}/${params.pseudo_aligner}/suppa/generate_events/per_isoform" },
                mode: params.publish_dir_mode,
                pattern: '*.ioi',
                saveAs: { filename -> (params.suppa && params.suppa_per_isoform) ? filename : null }
            ]
        ]
    }

    withName: '.*:SUPPA_SALMON:MERGEEVENTS' {
        publishDir = [
            path: { "${params.outdir}/${params.pseudo_aligner}/suppa/generate_events/per_local_event/merged_events" },
            mode: params.publish_dir_mode,
            pattern: '*.ioe',
            saveAs: { filename -> (params.suppa && params.suppa_per_local_event) ? filename : null }
        ]
    }

    withName: '.*:SUPPA_SALMON:SUPPA_PSIPEREVENT' {
        publishDir = [
            path: { "${params.outdir}/${params.pseudo_aligner}/suppa/psi_per_local_event" },
            mode: params.publish_dir_mode,
            pattern: '*.psi',
            saveAs: { filename -> (params.suppa && params.suppa_per_local_event) ? filename : null }
        ]
    }

    withName: '.*:SUPPA_SALMON:SUPPA_PSIPERISOFORM' {
        publishDir = [
            path: { "${params.outdir}/${params.pseudo_aligner}/suppa/psi_per_isoform" },
            mode: params.publish_dir_mode,
            pattern: '*.psi',
            saveAs: { filename -> (params.suppa && params.suppa_per_isoform) ? filename : null }
        ]
    }

    withName: '.*:SUPPA_SALMON:SPLITFILES_(TPM|PSI)' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.pseudo_aligner}/suppa/split_files/per_local_event" },
                mode: params.publish_dir_mode,
                pattern: 'local*.{tpm,psi}',
                saveAs: { filename -> (params.suppa && params.suppa_per_local_event) ? filename : null }
            ],
            [
                path: { "${params.outdir}/${params.pseudo_aligner}/suppa/split_files/per_isoform" },
                mode: params.publish_dir_mode,
                pattern: 'transcript*.{tpm,psi}',
                saveAs: { filename -> (params.suppa && params.suppa_per_isoform) ? filename : null }
            ],
            [
                path: { "${params.outdir}/${params.pseudo_aligner}/suppa/split_files/tpms" },
                mode: params.publish_dir_mode,
                pattern: '*.tpm',
                saveAs: { filename -> params.suppa ? filename : null }
            ]
        ]
    }

    withName: '.*:SUPPA_SALMON:SPLITFILES_TPM' {
        ext.prefix = { meta.condition }
    }

    withName: '.*:SUPPA_SALMON:CLUSTERGROUPS' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.pseudo_aligner}/suppa/clustergroups" },
                mode: params.publish_dir_mode,
                pattern: '*_groups.txt',
                saveAs: { filename -> params.suppa ? filename : null }
            ]
        ]
    }

    withName: '.*:SUPPA_SALMON:SUPPA_DIFFSPLICE' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.pseudo_aligner}/suppa/diffsplice/per_local_event" },
                mode: params.publish_dir_mode,
                pattern: '*local*.{dpsi,psivec}',
                saveAs: { filename -> (params.suppa && params.suppa_per_local_event) ? filename : null }
            ],
            [
                path: { "${params.outdir}/${params.pseudo_aligner}/suppa/diffsplice/per_isoform" },
                mode: params.publish_dir_mode,
                pattern: '*transcript*.{dpsi,psivec}',
                saveAs: { filename -> (params.suppa && params.suppa_per_isoform) ? filename : null }
            ]
        ]
    }

    withName: '.*:SUPPA_SALMON:GENEANNOTATION_ANNOTATE' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.pseudo_aligner}/suppa/diffsplice/per_local_event" },
                mode: params.publish_dir_mode,
                pattern: 'local_*.annotated.tsv',
                saveAs: { filename -> (params.suppa && params.suppa_per_local_event) ? filename : null }
            ],
            [
                path: { "${params.outdir}/${params.pseudo_aligner}/suppa/diffsplice/per_isoform" },
                mode: params.publish_dir_mode,
                pattern: 'transcript_*.annotated.tsv',
                saveAs: { filename -> (params.suppa && params.suppa_per_isoform) ? filename : null }
            ]
        ]
    }

    withName: '.*:SUPPA_SALMON:SUPPA_CLUSTEREVENTS' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.pseudo_aligner}/suppa/clusterevents/per_local_event" },
                mode: params.publish_dir_mode,
                pattern: '*local*.{clustvec,log}',
                saveAs: { filename -> (params.suppa && params.suppa_per_local_event) ? filename : null }
            ],
            [
                path: { "${params.outdir}/${params.pseudo_aligner}/suppa/clusterevents/per_isoform" },
                mode: params.publish_dir_mode,
                pattern: '*transcript*.{clustvec,log}',
                saveAs: { filename -> (params.suppa && params.suppa_per_isoform) ? filename : null }
            ]
        ]
    }

    // --- Tximport Tracks ---
    withName: '.*:QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:CUSTOM_TX2GENE' {
        ext.prefix = { gtf.baseName }
    }

    withName: '.*:QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:TXIMETA_TXIMPORT' {
        ext.args   = { params.ignore_tx_version ? '--ignore_tx_version true' : '--ignore_tx_version false' }
        ext.prefix = 'salmon.merged'
    }

    withName: '.*:QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:SE_GENE_UNIFIED' {
        ext.args   = '--assay_names counts,counts_length_scaled,counts_scaled,lengths,tpm'
        ext.prefix = 'salmon.merged.gene'
    }

    withName: '.*:QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:SE_TRANSCRIPT_UNIFIED' {
        ext.args   = '--assay_names counts,counts_scaled,counts_dtu_scaled,lengths,tpm'
        ext.prefix = 'salmon.merged.transcript'
    }

    withName: '.*:TX2GENE_TXIMPORT_STAR_SALMON:(QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:.*|SUPPATPM)' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/tximport" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                return filename
            }
        ]
    }

    withName: '.*:TX2GENE_TXIMPORT_SALMON:(UNTAR|QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:.*|SUPPATPM)' {
        publishDir = [
            path: { "${params.outdir}/${params.pseudo_aligner}/tximport" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                return filename
            }
        ]
    }

    // --- MISO / Sashimi Plots ---
    withName: 'GFFREAD_GTF2GFF3' {
        ext.args   = '-L --keep-genes'
        ext.prefix = { "${meta.id}_genes" }
        publishDir = [
            path: { "${params.outdir}/misopy" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!params.sashimi_plot) return null
                return filename
            }
        ]
    }

    withName: 'MISOPY_INDEX' {
        publishDir = [
            path: { "${params.outdir}/misopy" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!params.sashimi_plot) return null
                return filename
            }
        ]
    }

    withName: 'MISOPY_RUN' {
        ext.args = { "--read-len ${params.miso_read_len}" }
        publishDir = [
            path: { "${params.outdir}/misopy" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!params.sashimi_plot) return null
                return filename
            }
        ]
    }

    withName: 'MISOPY_SETTINGS' {
        publishDir = [
            path: { "${params.outdir}/misopy" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!params.sashimi_plot) return null
                return filename
            }        ]
    }

    withName: 'MISOPY_SASHIMIPLOT' {
        publishDir = [
            path: { "${params.outdir}/misopy/sashimi" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (!params.sashimi_plot) return null
                return filename
            }
        ]
    }
}
