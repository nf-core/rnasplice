/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run the DEXSeq exon and DTU, edgeR and
    LeafCutter analyses with a blocking variable set on one of the two contrasts.

    Use as follows:
        nextflow run nf-core/rnasplice -profile test_blocking,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {

    // Config information
    config_profile_name        = 'Blocking test profile'
    config_profile_description = 'Minimal test dataset to check the DEXSeq, edgeR and LeafCutter analyses with a blocking variable'

    // Input data. The samplesheet has a batch column crossed with condition, and the
    // contrastsheet blocks GBR-YRI on it but not YRI-GBR
    input     = 'https://raw.githubusercontent.com/nf-core/test-datasets/rnasplice/chrX_subset/samplesheet/samplesheet_blocking.csv'
    contrasts = 'https://raw.githubusercontent.com/nf-core/test-datasets/rnasplice/chrX_subset/samplesheet/contrastsheet_blocking.csv'

    // Genome references
    fasta = 'https://raw.githubusercontent.com/nf-core/test-datasets/rnasplice/chrX_subset/reference/X.fa.gz'
    gtf   = 'https://raw.githubusercontent.com/nf-core/test-datasets/rnasplice/chrX_subset/reference/genes_chrX.gtf'

    // Other parameters. Only the analyses that use blocking variables are under test here
    dexseq_exon           = true
    dexseq_dtu            = true
    edger_exon            = true
    leafcutter            = true
    rmats                 = false
    suppa                 = false
    isoformswitchanalyzer = false
    sashimi_plot          = false

    // The test data has two samples per condition, fewer than leafcutter-ds asks for by
    // default, and a single cluster of a few reads per sample, so the thresholds are
    // lowered for the contrasts to be tested
    leafcutter_ds_min_samples_per_intron = 2
    leafcutter_ds_min_samples_per_group  = 2
    leafcutter_ds_min_coverage           = 1

}

// Limit resources so that this can run on GitHub Actions
process {
  resourceLimits = [
    cpus: 2,
    memory: 6.GB,
    time: 6.h
  ]
}
