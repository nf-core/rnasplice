%%metro title: nf-core/rnasplice
%%metro logo: nf-core-rnasplice_logo_light.png | nf-core-rnasplice_logo_dark.png
%%metro style: nfcore
%%metro center_ports: true
%%metro compact_offsets: true
%%metro font_scale: 1.6
%%metro stroke_scale: 1.5
%%metro x_spacing: 120
%%metro animate: true
%%metro files: fastq_in | FASTQ | Reads
%%metro file: genome_bam_in | BAM | Genome
%%metro file: transcriptome_bam_in | BAM | Transcriptome
%%metro dir: salmon_in | Salmon | Quant
%%metro file: deu_out | TSV | DEU
%%metro file: dtu_out | TSV | DTU
%%metro file: event_exon_out | TSV | Events
%%metro file: event_tx_out | TSV | Events
%%metro file: bigwig_out | BW | Coverage
%%metro file: sashimi_out | PDF | Sashimi
%%metro file: report_out | HTML | MultiQC
%%metro off_track: genome_bam_in, transcriptome_bam_in, salmon_in
%%metro line: event | Event-based splicing | #f39c12
%%metro line: deu | Differential exon usage (DEU) | #e63946
%%metro line: qc | QC & visualisation | #2db572
%%metro line: dtu | Differential transcript usage (DTU) | #4361ee
%%metro legend: bl
%%metro grid: preprocessing | 0,0
%%metro grid: exon_analysis | 1,0
%%metro grid: reporting | 2,0
%%metro grid: quantification | 1,1
%%metro grid: transcript_analysis | 2,1

graph LR
    subgraph preprocessing [Pre-processing & alignment]
        fastq_in[ ]
        fastqc_raw[FastQC]
        trimgalore[Trim Galore]
        fastqc_trim[FastQC]
        star[STAR]

        fastq_in -->|deu,dtu,event,qc| fastqc_raw
        fastqc_raw -->|deu,dtu,event,qc| trimgalore
        trimgalore -->|deu,dtu,event,qc| fastqc_trim
        fastqc_trim -->|deu,dtu,event,qc| star
    end

    subgraph quantification [Transcript quantification]
        transcriptome_bam_in[ ]
        salmon_in[ ]
        salmon[Salmon]
        tximport[tximport]

        transcriptome_bam_in -->|dtu,event| salmon
        salmon -->|dtu,event| tximport
        salmon_in -->|dtu,event| tximport
    end

    subgraph exon_analysis [Exon & junction based analysis]
        genome_bam_in[ ]
        samtools[SAMtools]
        %% Hidden stations, so the lines leave SAMtools together and a single DEU line splits later
        _split[hidden]
        _deu[hidden]
        htseq[HTSeq]
        dexseq_exon[DEXSeq]
        featurecounts[featureCounts]
        edger[edgeR]
        rmats[rMATS]
        regtools[regtools]
        leafcutter[LeafCutter]
        deu_out[ ]
        event_exon_out[ ]

        genome_bam_in -->|deu,event,qc| samtools
        samtools -->|deu,event,qc| _split
        _split -->|deu| _deu
        _deu -->|deu| htseq
        _deu -->|deu| featurecounts
        _split -->|event| rmats
        _split -->|event| regtools
        htseq -->|deu| dexseq_exon
        featurecounts -->|deu| edger
        regtools -->|event| leafcutter
        dexseq_exon -->|deu| deu_out
        edger -->|deu| deu_out
        rmats -->|event| event_exon_out
        leafcutter -->|event| event_exon_out
    end

    subgraph transcript_analysis [Transcript based analysis]
        drimseq[DRIMSeq]
        dexseq_dtu[DEXSeq]
        stager[stageR]
        isar[IsoformSwitchAnalyzeR]
        suppa_events[SUPPA events]
        suppa_psi[SUPPA PSI]
        suppa_diff[SUPPA diffSplice]
        suppa_cluster[SUPPA cluster]
        dtu_out[ ]
        event_tx_out[ ]

        drimseq -->|dtu| dexseq_dtu
        dexseq_dtu -->|dtu| stager
        stager -->|dtu| dtu_out
        isar -->|dtu| dtu_out
        suppa_events -->|event| suppa_psi
        suppa_psi -->|event| suppa_diff
        suppa_diff -->|event| suppa_cluster
        suppa_cluster -->|event| event_tx_out
    end

    subgraph reporting [Visualisation & reporting]
        bedtools[BEDTools]
        bigwig[bedGraphToBigWig]
        miso[MISO sashimi]
        multiqc[MultiQC]
        bigwig_out[ ]
        sashimi_out[ ]
        report_out[ ]

        bedtools -->|qc| bigwig
        bigwig -->|qc| bigwig_out
        miso -->|qc| sashimi_out
        multiqc -->|deu,dtu,event,qc| report_out
    end

    %% Inter-section edges
    star -->|dtu,event| salmon
    star -->|deu,event,qc| samtools
    _split -->|qc| bedtools
    _split -->|qc| miso
    tximport -->|dtu| drimseq
    tximport -->|event| suppa_events
    salmon -->|dtu| isar
    _split -->|deu,event,qc| multiqc
    salmon -->|dtu| multiqc
